---
import resources from '~/data/buyer-resources.json';
import { normalizeSeoPath } from '~/utils/seo';
import { isolateLatin } from '~/utils/bidi';
import costPlanning from '~/data/cost-planning-links.json';

interface Resources {
  title: string;
  text: string;
  links: Array<{ href: string; text: string }>;
}
const guide = (resources as Record<string, Resources>)[normalizeSeoPath(Astro.url.pathname)];
const { calculatorOnly = false } = Astro.props as { calculatorOnly?: boolean };
const costHelp = (costPlanning as Record<string, { title: string; text: string; linkText: string; inline?: boolean }>)[
  normalizeSeoPath(Astro.url.pathname)
];
const showCalculator = costHelp && (calculatorOnly || !costHelp.inline);
---

{
  guide && !calculatorOnly && (
    <section data-buyer-resources class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
      <h2 class="text-2xl md:text-3xl font-bold mb-4" set:html={isolateLatin(guide.title)} />
      <p class="text-lg text-muted mb-6 max-w-4xl" set:html={isolateLatin(guide.text)} />
      <ul class="grid gap-3 md:grid-cols-3 list-none">
        {guide.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block h-full rounded-xl border border-gray-200 dark:border-slate-700 p-4 text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
              set:html={isolateLatin(link.text)}
            />
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  showCalculator && (
    <section data-calculator-resource class="max-w-6xl mx-auto px-4 sm:px-6 py-6 md:py-8">
      <div class="rounded-2xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900 p-5 sm:p-6 md:flex md:items-center md:justify-between md:gap-8">
        <div class="max-w-3xl">
          <h2 class="text-xl font-bold mb-2" set:html={isolateLatin(costHelp.title)} />
          <p class="text-muted leading-relaxed" set:html={isolateLatin(costHelp.text)} />
        </div>
        <a
          href="/import-cost-calculator"
          class="inline-block mt-4 md:mt-0 md:max-w-64 md:shrink-0 font-semibold text-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          set:html={isolateLatin(costHelp.linkText)}
        />
      </div>
    </section>
  )
}
