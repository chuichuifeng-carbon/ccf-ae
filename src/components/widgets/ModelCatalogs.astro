---
import catalogs from '~/data/b2b/catalogs.json';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

import { whatsappUrl } from '~/utils/inquiry';
const { brand } = Astro.props as { brand?: string };
const names: Record<string, string> = {
  bmw: 'BMW',
  'mercedes-amg': 'Mercedes-AMG',
  porsche: 'Porsche',
};
const groups = brand ? catalogs.filter((group) => group.brand === brand) : catalogs;
---

<section id="model-catalogs" class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16 scroll-mt-24">
  <Headline
    title="Каталоги по моделям"
    subtitle="Откройте PDF и отправьте название каталога, номер позиции и количество для расчёта цены."
  />
  <a href="/import-cost-calculator/" class="inline-block text-primary underline mb-6">Рассчитать стоимость импорта →</a>
  <div class="space-y-10">
    {
      groups.map((group) => (
        <div id={`catalogs-${group.brand}`}>
          <h3 class="text-2xl font-bold mb-4">{names[group.brand]}</h3>
          <a class="text-primary underline inline-block mb-4" href={group.source}>
            Оригинальные каталоги {names[group.brand]} на основном сайте CCF
          </a>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.entries.map((entry) => (
              <article
                data-model-card
                class="overflow-hidden rounded-2xl border border-gray-200 dark:border-slate-700 bg-page"
              >
                <a
                  href={entry.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Каталог ${names[group.brand]} ${entry.model}`}
                >
                  <img
                    src={entry.image}
                    alt={entry.imageAlt}
                    loading="lazy"
                    decoding="async"
                    sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 420px"
                    class="w-full aspect-[16/10] object-contain bg-gray-50 dark:bg-slate-900"
                  />
                </a>
                <div class="p-5">
                  <h4 class="font-bold text-lg mb-4">
                    <bdi dir="ltr">{entry.model}</bdi>
                  </h4>
                  <div class="flex flex-wrap gap-3">
                    <Button
                      variant="primary"
                      href={whatsappUrl(`Каталог ${names[group.brand]} ${entry.model}`, entry.url)}
                      data-inquiry-context={`Каталог ${names[group.brand]} ${entry.model}`}
                      data-inquiry-reference={entry.url}
                      target="_blank"
                      text="Запросить детали"
                      icon="tabler:brand-whatsapp"
                    />
                    <Button
                      variant="secondary"
                      href={entry.url}
                      target="_blank"
                      text="Открыть PDF"
                      icon="tabler:file-type-pdf"
                    />
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
  <p class="mt-6 text-sm text-muted">
    Оригинальные PDF размещены на ccfrp.com и могут содержать английский и китайский текст. Для подбора отправьте
    модель, год автомобиля и номер позиции из каталога.
  </p>
</section>
