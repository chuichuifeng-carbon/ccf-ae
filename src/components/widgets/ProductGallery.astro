---
import { Icon } from 'astro-icon/components';

interface GalleryImage {
  lg: { url: string; width: number; height: number };
  md: { url: string; width: number; height: number };
  sm: { url: string; width: number; height: number };
}

interface Props {
  product: { title: string; images: GalleryImage[] };
}
const { product } = Astro.props;
const images = product.images;
const first = images[0].lg;
---

<ccf-product-gallery class="block min-w-0">
  <div
    class="relative isolate overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 dark:border-slate-700 dark:bg-slate-900"
  >
    <a
      data-full
      href={first.url}
      aria-label="Открыть крупное фото"
      class="group relative block cursor-zoom-in focus-visible:outline-offset-[-4px]"
    >
      <img
        data-main
        src={first.url}
        width={first.width}
        height={first.height}
        sizes="(min-width: 1280px) 660px, (min-width: 1024px) 54vw, 100vw"
        alt={product.title}
        fetchpriority="high"
        loading="eager"
        class="block w-full aspect-[5/4] sm:aspect-[4/3] object-contain"
      />
      <span
        class="absolute bottom-3 end-3 grid size-11 place-items-center rounded-full bg-white text-slate-900 shadow-sm group-hover:bg-slate-100"
        ><Icon name="tabler:zoom-in" class="size-5" /></span
      >
    </a>
    {
      images.length > 1 && (
        <span
          data-counter
          dir="ltr"
          aria-live="polite"
          class="pointer-events-none absolute bottom-3 right-3 rounded-full bg-slate-950/80 px-3 py-1 text-xs font-medium tabular-nums text-white"
        >
          1 / {images.length}
        </span>
      )
    }
  </div>
  {
    images.length > 1 && (
      <div class="mt-3 flex max-w-full gap-2 overflow-x-auto p-1" role="group" aria-label="Фотографии товара">
        {images.map(({ lg, md }, i) => (
          <a
            href={lg.url}
            data-thumb
            aria-current={i === 0 ? 'true' : undefined}
            aria-label={`Показать фото ${i + 1} из ${images.length}`}
            class="shrink-0 overflow-hidden rounded-lg border border-slate-300 bg-slate-100 aria-current:outline-2 aria-current:outline-offset-1 aria-current:outline-primary dark:bg-slate-900"
          >
            <img
              src={md.url}
              width={md.width}
              height={md.height}
              alt={`${product.title} — фото ${i + 1}`}
              sizes="72px"
              loading="lazy"
              class="size-16 object-contain sm:size-[72px]"
            />
          </a>
        ))}
      </div>
    )
  }
  <p class="mt-3 text-sm text-muted">Комплект поставки указан в предложении.</p>
  <dialog
    aria-label="Фотографии в полном размере"
    class="m-auto w-[96vw] max-w-6xl rounded-xl bg-slate-950 p-2 text-white backdrop:bg-black/85"
  >
    <div class="flex items-center justify-between px-2 pb-2">
      <button data-close aria-label="Закрыть" class="grid size-11 place-items-center rounded-full hover:bg-white/15"
        ><Icon name="tabler:x" class="size-5" /></button
      >
      {
        images.length > 1 && (
          <div class="flex items-center gap-2">
            <button
              data-prev
              aria-label="Предыдущее фото"
              class="grid size-11 place-items-center rounded-full hover:bg-white/15"
            >
              <Icon name="tabler:chevron-left" class="size-5" />
            </button>
            <span data-position dir="ltr" aria-live="polite" class="text-sm tabular-nums" />
            <button
              data-next
              aria-label="Следующее фото"
              class="grid size-11 place-items-center rounded-full hover:bg-white/15"
            >
              <Icon name="tabler:chevron-right" class="size-5" />
            </button>
          </div>
        )
      }
    </div>
    <button
      data-zoom
      aria-label="Увеличить фото"
      aria-pressed="false"
      class="rounded-lg border border-white/30 px-4 py-2 mb-2">Увеличить ×2</button
    >
    <div data-view dir="ltr" class="h-[min(70dvh,900px)] overflow-auto overscroll-contain">
      <div data-canvas class="h-full w-full"></div>
    </div>
  </dialog>
</ccf-product-gallery>

<script>
  class ProductGallery extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const full = this.querySelector<HTMLAnchorElement>('[data-full]')!;
      const main = this.querySelector<HTMLImageElement>('[data-main]')!;
      const thumbs = Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-thumb]'));
      const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
      const enlarged = new Image();
      enlarged.className = 'h-full max-h-full w-full object-contain';
      const canvas = this.querySelector<HTMLElement>('[data-canvas]')!;
      const view = this.querySelector<HTMLElement>('[data-view]')!;
      const zoomButton = this.querySelector<HTMLButtonElement>('[data-zoom]')!;
      canvas.append(enlarged);
      let zoomed = false;
      const setZoom = (value: boolean) => {
        zoomed = value;
        canvas.style.width = value ? '200%' : '100%';
        canvas.style.height = value ? '200%' : '100%';
        zoomButton.textContent = value ? 'Масштаб ×1' : 'Увеличить ×2';
        zoomButton.setAttribute('aria-pressed', String(value));
        if (!value) {
          view.scrollLeft = 0;
          view.scrollTop = 0;
        }
      };
      zoomButton.addEventListener('click', () => setZoom(!zoomed));
      enlarged.addEventListener('dblclick', () => setZoom(!zoomed));
      enlarged.draggable = false;
      let drag: { x: number; y: number; left: number; top: number } | undefined;
      view.addEventListener('pointerdown', (event) => {
        if (!zoomed || event.pointerType !== 'mouse' || event.button !== 0) return;
        drag = { x: event.clientX, y: event.clientY, left: view.scrollLeft, top: view.scrollTop };
        view.setPointerCapture(event.pointerId);
      });
      view.addEventListener('pointermove', (event) => {
        if (!drag) return;
        view.scrollLeft = drag.left + drag.x - event.clientX;
        view.scrollTop = drag.top + drag.y - event.clientY;
      });
      view.addEventListener('pointerup', () => {
        drag = undefined;
      });
      view.addEventListener('lostpointercapture', () => {
        drag = undefined;
      });
      dialog.addEventListener('close', () => setZoom(false));
      let current = 0;
      const select = (index: number) => {
        if (!thumbs.length) return;
        setZoom(false);
        current = (index + thumbs.length) % thumbs.length;
        const active = thumbs[current];
        const preview = active.querySelector('img')!;
        for (const thumb of thumbs) thumb.removeAttribute('aria-current');
        active.setAttribute('aria-current', 'true');
        main.srcset = preview.srcset;
        main.src = preview.src;
        main.alt = preview.alt;
        full.href = active.href;
        const position = `${current + 1} / ${thumbs.length}`;
        this.querySelector('[data-counter]')!.textContent = position;
        this.querySelector('[data-position]')!.textContent = position;
        if (dialog.open) {
          enlarged.src = full.href;
          enlarged.alt = main.alt;
        }
      };
      thumbs.forEach((thumb, index) =>
        thumb.addEventListener('click', (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          select(index);
        })
      );
      full.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        enlarged.src = full.href;
        enlarged.alt = main.alt;
        const position = this.querySelector('[data-position]');
        if (position) position.textContent = `${current + 1} / ${thumbs.length}`;
        dialog.showModal();
      });
      this.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
      this.querySelector('[data-prev]')?.addEventListener('click', () => select(current - 1));
      this.querySelector('[data-next]')?.addEventListener('click', () => select(current + 1));
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          select(current + (event.key === 'ArrowRight' ? 1 : -1));
        }
      });
    }
  }
  if (!customElements.get('ccf-product-gallery')) customElements.define('ccf-product-gallery', ProductGallery);
</script>
