---
import { allProducts } from '~/data/b2b/all-products';
import Headline from '~/components/ui/Headline.astro';

const featured = allProducts
  .filter((p) => p.imageCount >= 8)
  .sort((a, b) => b.imageCount - a.imageCount)
  .slice(0, 4);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16">
  <Headline
    title="منتجاتنا المميزة"
    subtitle={`راجع مراجع مصورة من بين ${allProducts.length} منتجاً. أكّد المادة والمطابقة والتوفر للمرجع المطلوب قبل طلب التوريد.`}
  />
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      featured.map((product) => (
        <a
          href={`/products/${product.slug}`}
          class="rounded-2xl overflow-hidden border border-gray-200 dark:border-slate-700 hover:shadow-lg hover:border-primary transition group"
        >
          <img
            src={product.featuredSm}
            alt={product.seoTitle || product.title}
            width="400"
            height="300"
            loading="lazy"
            class="w-full h-52 object-contain bg-black group-hover:scale-[1.03] transition"
          />
          <div class="p-5">
            <p class="text-xs text-muted mb-1">
              <bdi dir="ltr">{product.model}</bdi>
            </p>
            <h3 class="font-bold text-base leading-snug line-clamp-2">{product.seoTitle || product.title}</h3>
            <p class="mt-3 text-primary text-sm">عرض التفاصيل وطلب السعر ←</p>
          </div>
        </a>
      ))
    }
  </div>
</section>
