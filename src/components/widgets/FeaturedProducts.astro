---
import { featuredProducts } from '~/data/b2b/featured';
import images from '~/data/b2b/product-images.json';
import Headline from '~/components/ui/Headline.astro';
const productImages = images as Record<string, { image: string }>;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16">
  <Headline
    title="منتجات مختارة بمعلومات تفصيلية"
    subtitle="صور المنتج ومراجع الكتالوج وأسئلة المطابقة في صفحات عربية، مع طلب عرض السعر مباشرة عبر واتساب."
  />
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      featuredProducts.map((product) => (
        <a
          href={`/products/${product.slug}`}
          class="rounded-2xl overflow-hidden border border-gray-200 dark:border-slate-700 hover:shadow-lg transition"
        >
          <img
            src={productImages[`https://ccfrp.com/${product.slug}/`]?.image}
            alt={product.title}
            width="600"
            height="450"
            loading="lazy"
            class="w-full h-52 object-contain bg-white"
          />
          <div class="p-5">
            <>
              <h3 class="font-bold text-lg">{product.title}</h3>
              <p class="mt-3 text-primary">عرض التفاصيل وطلب السعر ←</p>
            </>
          </div>
        </a>
      ))
    }
  </div>
</section>
