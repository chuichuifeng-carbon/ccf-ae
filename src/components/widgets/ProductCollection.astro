---
import { allProducts } from '~/data/b2b/all-products';
import Button from '~/components/ui/Button.astro';
import { whatsappUrl } from '~/utils/inquiry';
import { getCanonical } from '~/utils/permalinks';

const { category, chassis, title } = Astro.props as { category?: string; chassis?: string; title?: string };

// 核心：从 all-products 按 categorySlug 过滤 + 排序（优先多图）
const filtered = allProducts
  .filter((p) => (!category || p.categorySlug === category) && (!chassis || p.chassisCodes.includes(chassis)))
  .sort((a, b) => b.imageCount - a.imageCount);

if (filtered.length === 0) {
  return null;
}
---

<section data-product-collection={category} class="max-w-[1720px] mx-auto px-4 sm:px-6 py-12 md:py-16">
  {title && <h2 class="text-3xl md:text-4xl font-bold mb-4">{title}</h2>}
  <p class="text-lg text-muted max-w-4xl mb-8">
    تصفّح {filtered.length} مرجعاً مصوراً. افتح تفاصيل القطعة لمراجعة التطبيق؛ المادة والمطابقة والتوفر تُؤكّد للطلب المحدد.
  </p>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {
      filtered.map((product) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-gray-200 dark:border-slate-700 bg-page group">
          <a href={`/products/${product.slug}`} aria-label={product.title} class="block bg-black">
            <img
              src={product.featuredSm}
              alt={product.seoTitle || product.title}
              width="400"
              height="300"
              loading="lazy"
              decoding="async"
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, (max-width: 1279px) 33vw, 25vw"
              class="w-full aspect-square object-contain bg-black group-hover:scale-[1.02] transition"
            />
          </a>
          <div class="p-5 flex flex-col flex-1">
            <p class="text-xs text-muted mb-1">
              <bdi dir="ltr">{product.model}</bdi>
            </p>
            <h3 class="font-bold mb-3 leading-snug">{product.seoTitle || product.title}</h3>
            <div class="mt-auto flex flex-wrap gap-3">
              <Button variant="primary" text="عرض التفاصيل" href={`/products/${product.slug}`} class="text-sm" />
              <Button
                variant="secondary"
                text="اطلب سعر"
                icon="tabler:brand-whatsapp"
                target="_blank"
                href={whatsappUrl(product.title, String(getCanonical(`/products/${product.slug}`)))}
                data-inquiry-context={product.title}
                data-inquiry-reference={String(getCanonical(`/products/${product.slug}`))}
                class="text-sm"
              />
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <p class="text-sm text-muted mt-6">
    قد تعرض صور التركيب أجزاء أخرى غير مشمولة. أكّد المرجع والمادة والتشطيب والقطع المتضمنة لطلبك المحدد.
  </p>
</section>
