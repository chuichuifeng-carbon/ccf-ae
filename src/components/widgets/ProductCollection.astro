---
import collections from '~/data/b2b/product-collections.json';
import { featuredProducts } from '~/data/b2b/featured';
import Button from '~/components/ui/Button.astro';
import { whatsappUrl } from '~/utils/inquiry';
import { isolateLatin } from '~/utils/bidi';

interface Product {
  model: string;
  title: string;
  sourceTitle: string;
  source: string;
  image: string;
  imageSource: string;
}
const { category, title } = Astro.props as { category: string; title: string };
const products = (collections as Record<string, Product[]>)[category] || [];
const detailLink = (product: Product) => {
  const slug = new URL(product.source).pathname.replace(/^\/|\/$/g, '');
  return featuredProducts.some((p) => p.slug === slug) ? `/products/${slug}` : product.source;
};
---

<section data-product-collection={category} class="max-w-[1720px] mx-auto px-4 sm:px-6 py-12 md:py-16">
  <h2 class="text-3xl md:text-4xl font-bold mb-4" set:html={isolateLatin(title)} />
  <p class="text-lg text-muted max-w-4xl mb-8">
    صور ومراجع المنتجات المنشورة على موقع CCF الرئيسي ضمن العلامات الثلاث. حدّد المركبة والمادة والتصميم ومحتويات
    التوريد قبل طلب السعر.
  </p>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {
      products.map((product) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-gray-200 dark:border-slate-700 bg-page">
          <a
            href={detailLink(product)}
            {...(detailLink(product).startsWith('https:') ? { target: '_blank', rel: 'noopener' } : {})}
            aria-label={product.title}
            class="block bg-white"
          >
            <img
              src={product.image}
              alt={product.title}
              loading="lazy"
              decoding="async"
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, (max-width: 1279px) 33vw, 420px"
              class="w-full aspect-square object-contain"
            />
          </a>
          <div class="p-5 flex flex-col flex-1">
            <p class="text-xs text-muted mb-2">
              <bdi dir="ltr">{product.model}</bdi>
            </p>
            <h3 class="text-lg font-bold mb-5" set:html={isolateLatin(product.title)} />
            <div class="mt-auto flex flex-wrap gap-3">
              <Button
                variant="primary"
                text="اسأل عبر واتساب"
                icon="tabler:brand-whatsapp"
                target="_blank"
                href={whatsappUrl(product.title, product.source)}
                data-inquiry-context={product.title}
                data-inquiry-reference={product.source}
              />
              <a
                href={detailLink(product)}
                {...(detailLink(product).startsWith('https:') ? { target: '_blank', rel: 'noopener' } : {})}
                class="text-sm underline self-center"
              >
                عرض التفاصيل
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
  <p class="text-sm text-muted mt-6">
    قد تعرض صور التركيب أجزاء أخرى غير مشمولة. أكّد المرجع والمادة والتشطيب والقطع المتضمنة لطلبك المحدد.
  </p>
</section>
