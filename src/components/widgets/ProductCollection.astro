---
import { productCardTitleRu } from '~/data/b2b/product-labels-ru';
import { allProducts } from '~/data/b2b/all-products';
import Button from '~/components/ui/Button.astro';
import { whatsappUrl } from '~/utils/inquiry';
import { getCanonical } from '~/utils/permalinks';
import { productReference } from '~/utils/product-reference';

const { category, chassis, title, limit } = Astro.props as {
  category?: string;
  chassis?: string;
  title?: string;
  limit?: number;
};

// 核心：从 all-products 按 categorySlug 过滤 + 排序（优先多图）
const filtered = allProducts
  .filter((p) => (!category || p.categorySlug === category) && (!chassis || p.chassisCodes.includes(chassis)))
  .sort((a, b) => b.imageCount - a.imageCount);
const shown = limit ? filtered.slice(0, limit) : filtered;
const truncated = shown.length < filtered.length;

if (filtered.length === 0) {
  return null;
}
---

<section data-product-collection={category || 'all'} class="max-w-[1720px] mx-auto px-4 sm:px-6 py-12 md:py-16">
  {title && <h2 class="text-3xl md:text-4xl font-bold mb-4">{title}</h2>}
  <p data-collection-summary class="text-lg text-muted max-w-4xl mb-8">
    Показано {shown.length}{truncated ? ` из ${filtered.length}` : ''} товаров. Откройте карточку, чтобы посмотреть фотографии
    и отправить запрос.
  </p>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {
      shown.map((product) => (
        <article
          data-category={product.categorySlug}
          data-chassis={product.chassisCodes.join(' ')}
          data-search={[productCardTitleRu(product), product.productDirName, product.model, product.partTypeEn]
            .join(' ')
            .toLowerCase()}
          class="flex flex-col overflow-hidden rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 group"
        >
          <a href={`/products/${product.slug}/`} aria-label={productCardTitleRu(product)} class="block bg-white">
            <img
              src={product.featuredSm}
              alt={productCardTitleRu(product)}
              width="400"
              height="300"
              loading="lazy"
              decoding="async"
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, (max-width: 1279px) 33vw, 25vw"
              class="w-full aspect-square object-contain bg-white group-hover:scale-[1.02] transition"
            />
          </a>
          <div class="p-5 flex flex-col flex-1">
            <p class="text-xs text-muted mb-1">
              <bdi dir="ltr">{product.model}</bdi>
            </p>
            <h3 class="font-bold mb-3 leading-snug">
              <a href={`/products/${product.slug}/`} class="hover:underline">
                {productCardTitleRu(product)}
              </a>
            </h3>
            <p class="text-xs text-muted mb-3">Код сайта: {productReference(product.slug)}</p>
            <div class="mt-auto flex flex-wrap gap-3">
              <Button variant="primary" text="Подробнее" href={`/products/${product.slug}/`} class="text-sm" />
              <Button
                variant="secondary"
                text="Запросить цену"
                icon="tabler:brand-whatsapp"
                target="_blank"
                href={whatsappUrl(productCardTitleRu(product), String(getCanonical(`/products/${product.slug}/`)))}
                data-inquiry-context={productCardTitleRu(product)}
                data-inquiry-reference={String(getCanonical(`/products/${product.slug}/`))}
                class="text-sm"
              />
            </div>
            <button
              hidden
              type="button"
              data-rfq-add={product.slug}
              data-rfq-title={product.title}
              class="btn-secondary w-full mt-3 text-sm"
            >
              В список запроса
            </button>
          </div>
        </article>
      ))
    }
  </div>

  {
    truncated && (
      <div class="mt-8">
        <Button variant="secondary" text={`Все товары (${allProducts.length})`} href="/products" />
      </div>
    )
  }

  <p class="text-sm text-muted mt-6">
    Для точного расчёта сообщите комплектацию автомобиля, количество и город доставки.
  </p>
</section>
