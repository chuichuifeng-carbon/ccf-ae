---
/**
 * WhatsAppFAB.astro
 * 全局悬浮 WhatsApp 按钮 — 固定右下角，桌面端圆形 + 移动端展开为完整条
 * 滚动 200px 后淡入，点击发起带上下文的 WhatsApp 对话
 */
import { whatsappUrl } from '~/utils/inquiry';

const { context = '', reference = '' } = Astro.props;
const href = whatsappUrl(context, reference);
---

<!-- 桌面端: 圆形 FAB 右下角 -->
<a
  id="whatsapp-fab"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="تواصل عبر واتساب"
  class="fixed bottom-6 right-6 z-50 group
         w-14 h-14 md:w-16 md:h-16 rounded-full
         bg-[#25D366] hover:bg-[#20BD5A] shadow-lg hover:shadow-xl
         flex items-center justify-center
         transition-all duration-300
         md:bottom-8 md:right-8
         hidden md:flex
         translate-y-2 opacity-0 pointer-events-none
         whatsapp-fab-ready"
>
  <!-- WhatsApp 图标 (SVG, 避免依赖 icon 组件) -->
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-8 h-8 md:w-9 md:h-9">
    <path
      d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.612-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
    ></path>
  </svg>
  <!-- 脉冲动画环 -->
  <span class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-60" aria-hidden="true"></span>
</a>

<!-- 移动端: 底部展开条 (比现有 StickyCTA 更显眼) -->
<div
  id="whatsapp-mobile-bar"
  class="fixed bottom-0 inset-x-0 z-40
         bg-[#25D366] text-white
         transform translate-y-full transition-transform duration-300
         md:hidden
         shadow-[0_-4px_20px_rgba(37,211,102,0.3)]"
>
  <a href={href} target="_blank" rel="noopener" class="flex items-center justify-between px-4 py-3">
    <div class="flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-7 h-7 shrink-0">
        <path
          d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.612-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
        ></path>
      </svg>
    </div>
    <div class="text-right">
      <div class="font-bold text-sm leading-tight">تواصل عبر واتساب</div>
      <div class="text-xs opacity-90 leading-tight">أرسل المرجع والكمية والوجهة</div>
    </div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="white"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-5 h-5 shrink-0 ml-2"><path d="M5 12h14M13 5l7 7-7 7"></path></svg
    >
  </a>
</div>

<script>
  // 滚动 200px 后淡入
  const threshold = 200;
  let ticking = false;
  const update = () => {
    const y = window.scrollY;
    const fab = document.getElementById('whatsapp-fab');
    const bar = document.getElementById('whatsapp-mobile-bar');
    const show = y > threshold;
    if (fab) {
      fab.classList.toggle('translate-y-2', !show);
      fab.classList.toggle('opacity-0', !show);
      fab.classList.toggle('pointer-events-none', !show);
      fab.classList.toggle('translate-y-0', show);
      fab.classList.toggle('opacity-100', show);
      fab.classList.toggle('pointer-events-auto', show);
    }
    if (bar) {
      bar.classList.toggle('translate-y-full', !show);
      bar.classList.toggle('translate-y-0', show);
    }
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true }
  );
  update();
  document.addEventListener('astro:page-load', update);
</script>
