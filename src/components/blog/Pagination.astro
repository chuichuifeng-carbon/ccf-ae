---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import { I18N } from 'astrowind:config';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

// `prevUrl`/`nextUrl` come from Astro's `page.url` and already include `base`
// and honour `trailingSlash`, so they must not go through `getPermalink()`
// (that would prefix `base` a second time, see #629).
const { prevUrl, nextUrl, prevText = 'مقالات أحدث', nextText = 'مقالات أقدم' } = Astro.props;
const rtl = I18N.textDirection === 'rtl';
---

{
  (prevUrl || nextUrl) && (
    <div class="container flex">
      <div class="flex flex-row mx-auto container justify-between">
        {prevUrl ? (
          <Button variant="tertiary" class="md:px-3 px-3 me-2" href={prevUrl}>
            <Icon name={rtl ? 'tabler:chevron-right' : 'tabler:chevron-left'} class="w-6 h-6" />
            <p class="ms-2">{prevText}</p>
          </Button>
        ) : (
          <span aria-hidden="true" />
        )}

        {nextUrl && (
          <Button variant="tertiary" class="md:px-3 px-3" href={nextUrl}>
            <span class="me-2">{nextText}</span>
            <Icon name={rtl ? 'tabler:chevron-left' : 'tabler:chevron-right'} class="w-6 h-6" />
          </Button>
        )}
      </div>
    </div>
  )
}
