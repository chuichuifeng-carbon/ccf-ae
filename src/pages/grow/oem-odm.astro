---
import SourceGallery from '~/components/widgets/SourceGallery.astro';
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تصنيع قطع كربون فايبر حسب الطلب OEM/ODM | CCF',
  description:
    'طوّر قطع كربون لعلامتك مع مصنع CCF. ابدأ بعينة أو CAD أو صور مرجعية؛ ناقش القوالب والنموذج الأولي واعتماد العينة قبل تحديد الإنتاج والسعر.',
};

import { img } from '~/utils/siteImages';
---

<PageLayout metadata={metadata}>
  <!-- HeroText -->
  <HeroText
    tagline="ألياف الكربون للسيارات · تصنيع OEM/ODM"
    title="تصنيع قطع ألياف الكربون حسب الطلب OEM/ODM"
    subtitle="اصنع قطع ألياف كربون خاصة بمركبة معينة لعلامة ما بعد البيع أو خط منتجاتك. ابدأ بعينة موجودة أو بيانات CAD أو صور مرجعية أو فكرة منتج — يراجع فريق CCF متطلبات القوالب والنماذج الأولية والإنتاج مع مشتري B2B."
    callToAction={{
      text: 'تواصل عبر واتساب',
      href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
      target: '_blank',
      icon: 'tabler:brand-whatsapp',
    }}
    callToAction2={{
      text: 'اطلب عرض سعر',
      href: 'https://ccfrp.com/contact/',
      target: '_blank',
      variant: 'secondary',
    }}
  />

  <SourceGallery />

  <!-- What you can start with -->
  <Features2
    tagline="بماذا يمكنك أن تبدأ"
    title="لا حاجة لرسم كامل للبدء"
    subtitle="تُراجع جدوى المشروع قبل التطوير — شارك ما لديك وسنحدد المعلومات الإضافية المطلوبة للتقييم المبدئي."
    columns={4}
    items={[
      {
        title: 'عينة أو قطعة موجودة',
        description: 'شارك مرجعاً مادياً لتقييم المشروع المبدئي.',
        icon: 'tabler:package',
      },
      {
        title: 'بيانات CAD أو رسومات فنية',
        description: 'قدّم الرسومات والأبعاد أو بيانات المنتج الموجودة.',
        icon: 'tabler:ruler-2',
      },
      {
        title: 'صورة مرجعية أو فكرة منتج',
        description: 'اشرح التصميم المقصود والنتيجة المطلوبة.',
        icon: 'tabler:photo',
      },
      {
        title: 'تطبيق المركبة',
        description: 'أخبرنا بطراز المركبة وسنتها والمكوّن المطلوب.',
        icon: 'tabler:car',
      },
    ]}
  />

  <!-- Capabilities -->
  <Content
    tagline="قدرات OEM/ODM"
    title="اصنع المنتج الذي يحتاجه سوقك"
    content="نطاق المنتجات: شفاه أمامية، ناشرات خلفية، تنانير جانبية، سبويلر وأجنحة، أغطية محرك، أغطية صناديق أمتعة وقطع داخلية مختارة. المشاريع المخصصة تخضع لمراجعة الجدوى. التركيز الرئيسي: الكربون الجاف · خيار الكربون الرطب · قوالب مخصصة · تشطيب لامع أو مطفي."
    image={{
      src: img(
        'carbon fiber car hood molding process with vacuum bagging in production workshop, manufacturing photography'
      ),
      alt: 'تصنيع قطع ألياف الكربون بالقوالب',
      aspect: '4/3',
    }}
    items={[
      {
        title: 'تطوير من مراجعك',
        description: 'ابدأ بعينة أو ملف CAD أو رسم أو فكرة منتج.',
        icon: 'tabler:pencil',
      },
      {
        title: 'مطابقة المركبة وطلب السوق',
        description: 'مراجعة ملاءمة المركبة والتصميم ومتطلبات المنتج قبل التطوير.',
        icon: 'tabler:target',
      },
      {
        title: 'خط منتجات مميز',
        description: 'استكشف تصاميم وتشطيبات وعلامات تجارية مخصصة لعملك.',
        icon: 'tabler:tag',
      },
    ]}
  />

  <!-- 5-step development workflow -->
  <Steps
    tagline="سير عمل التطوير"
    title="خمس خطوات إلى الإنتاج"
    subtitle="منهج منظم لتطوير قطع ألياف الكربون المخصصة واعتمادها."
    isReversed
    image={{
      src: img(
        'engineer inspecting glossy carbon fiber spoiler prototype in clean workshop, quality check photography'
      ),
      alt: 'فحص نموذج أولي من ألياف الكربون',
    }}
    items={[
      {
        title: 'مراجعة المشروع',
        description: 'تأكيد المركبة والقطعة ومتطلبات التصميم.',
        icon: 'tabler:search',
      },
      {
        title: 'دراسة الجدوى',
        description: 'تقييم المواد والقوالب ونطاق الإنتاج.',
        icon: 'tabler:flask-2',
      },
      {
        title: 'النموذج الأولي',
        description: 'تطوير القوالب والعينات حسب الاتفاق.',
        icon: 'tabler:assembly',
      },
      {
        title: 'الموافقة',
        description: 'مراجعة المطابقة والتشطيب ومتطلبات العينة.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'الإنتاج',
        description: 'التصنيع وفق المواصفات المعتمدة.',
        icon: 'tabler:building-factory-2',
      },
    ]}
  />

  <!-- Technical customization -->
  <Features2
    tagline="التخصيص الفني"
    title="تفاصيل تحدد منتجك"
    subtitle="مظهر المادة وتشطيب السطح وملاءمة المركبة — كلها عناصر تُراجع وتُتفق قبل الإنتاج."
    columns={3}
    items={[
      {
        title: 'المادة ونسيج الكربون',
        description: 'مراجعة اختيار المادة ونمط النسيج واتساق مظهر ألياف الكربون الظاهر.',
        icon: 'tabler:layers-intersect',
      },
      {
        title: 'تشطيب لامع أو مطفي',
        description: 'مناقشة مظهر السطح ومتطلبات التشطيب والتوقعات التجميلية.',
        icon: 'tabler:eye',
      },
      {
        title: 'ملاءمة المركبة',
        description: 'تأكيد الطراز والسنة ونسخة الهيكل وتوافق نقاط التثبيت.',
        icon: 'tabler:car',
      },
    ]}
  />

  <!-- Commercial terms -->
  <Features2
    tagline="الشروط التجارية والمشروع"
    title="وضّح الشروط قبل التطوير"
    subtitle="انسِق الترتيبات المهمة قبل الالتزام بالقوالب أو الإنتاج — هذه الترتيبات خاصة بكل مشروع وتُؤكد كتابةً."
    columns={3}
    items={[
      {
        title: 'القوالب والملكية',
        description: 'الاتفاق كتابةً على تكاليف القوالب وملكيتها وحقوق استخدامها.',
        icon: 'tabler:settings',
      },
      {
        title: 'السرية والحصرية',
        description: 'مناقشة سرية التصميم وأي حصرية متفق عليها بشكل منفصل.',
        icon: 'tabler:lock',
      },
      {
        title: 'MOQ والعينات ومدة التسليم',
        description: 'تأكيد كميات الطلب وشروط العينات والجداول الزمنية لكل مشروع.',
        icon: 'tabler:calendar-time',
      },
    ]}
  />

  <!-- OEM/ODM FAQ -->
  <FAQs
    tagline="دليل مشتري OEM/ODM"
    title="أسئلة شائعة قبل أن تبدأ"
    subtitle="تخطط لمشروع ألياف كربون مخصص؟ إجابات عملية حول المراجع والعينات والكميات الدنيا والقوالب وترتيبات المشاريع."
    schema
    items={[
      {
        title: 'ما المعلومات المطلوبة لبدء مشروع OEM؟',
        description:
          'ابدأ بماركة المركبة وطرازها وسنتها ورمز الهيكل والمكوّن المطلوب. تساعد الصور المرجعية أو العينات الموجودة أو ملفات CAD أو الرسومات في شرح متطلبات التصميم. أضف أيضاً الكمية المقدرة والسوق المستهدف وأي تفضيلات للمواد أو التشطيب أو العلامة التجارية أو التغليف — ستراجع CCF المعلومات المتاحة وتحدد أي تفاصيل إضافية مطلوبة لتقييم المشروع.',
      },
      {
        title: 'هل يمكن لـ CCF تطوير قطعة من عينتي الموجودة؟',
        description:
          'يمكن تقديم العينات المادية الموجودة كمرجع لتطوير قطع ألياف كربون مخصصة. قد تساعد أيضاً ملفات CAD والرسومات والقياسات والصور المرجعية في تحديد التصميم المقصود. يعتمد أسلوب التطوير على المكوّن وتطبيق المركبة ومتطلبات القوالب وجدوى التصنيع.',
      },
      {
        title: 'هل يمكنني اعتماد عينة قبل الإنتاج بالجملة؟',
        description:
          'تُقيَّم ترتيبات تطوير العينات واعتمادها وفقاً لمشروع OEM/ODM المحدد. وحيث يشمل الاتفاق اعتماد عينة، قد تغطي المتطلبات الأبعاد ونقاط التثبيت وملاءمة المركبة ونسيج الكربون وتشطيب السطح. يجب تأكيد شروط العينة ومعايير القبول قبل بدء التطوير.',
      },
      {
        title: 'ما الحد الأدنى لكمية الطلب للقطع المخصصة؟',
        description:
          'لا يوجد حد أدنى واحد ينطبق على كل مشروع ألياف كربون مخصص. تُقيَّم الكميات الدنيا حسب المكوّن وطريقة التصنيع ومتطلبات القوالب ومواصفات المشروع. شارك مراجع منتجك والكمية المقدرة للشراء حتى نناقش متطلبات الطلب المطبقة.',
      },
      {
        title: 'كم يستغرق تطوير OEM/ODM؟',
        description:
          'تعتمد الجداول الزمنية على تصميم المنتج وتعقيده الفني ومتطلبات القوالب ومراجعات العينات وترتيبات الإنتاج. المشروع المبني على مراجع موجودة يختلف عن تصميم جديد كلياً. يمكن لـ CCF مناقشة جدول خاص بالمشروع بعد مراجعة النطاق الفني — لا يُفترض أي موعد ثابت قبل التقييم.',
      },
      {
        title: 'هل يمكن تخصيص العلامة التجارية والتغليف؟',
        description:
          'يمكن مناقشة وضع الشعار وملصقات المنتج وتغليف العلامة الخاصة ومتطلبات العلامات ذات الصلة ضمن مشروع OEM/ODM. تعتمد خيارات التخصيص المتاحة على المنتج وكمية الطلب والمتطلبات الفنية — يمكنك تقديم ملفات الشعار والموضع المفضل ومراجع التغليف ومواصفات الملصقات لمراجعة الجدوى.',
      },
      {
        title: 'من يملك القوالب في مشروع مخصص؟',
        description:
          'تُحدَّد ملكية القوالب بالاتفاق الكتابي بين CCF والعميل. قبل بدء التطوير، يجب على الطرفين توضيح تكاليف القوالب وملكيتها والاستخدام المسموح ومسؤوليات الصيانة وأي حقوق إنتاج مستقبلية. هذه الترتيبات خاصة بكل مشروع ولا ينبغي افتراضها دون تأكيد كتابي.',
      },
      {
        title: 'هل يمكن أن تبقى تصاميمي سرية أو حصرية؟',
        description:
          'يمكن مناقشة ترتيبات السرية لتصاميم العملاء والوثائق الفنية ومعلومات المشروع الحساسة. وعند الحاجة، يمكن للطرفين التفاوض على اتفاق كتابي منفصل يغطي السرية أو الحصرية. الحقوق الحصرية لمنتج أو عميل أو سوق ليست تلقائية وتعتمد على الشروط المحددة المتفق عليها بين الطرفين.',
      },
    ]}
  />

  <!-- Closing CTA -->
  <CallToAction
    layout="banner"
    title="لديك منتج في ذهنك؟"
    subtitle="شارك طراز مركبتك والمكوّن المستهدف والمراجع المتاحة لبدء مناقشة مشروع — لا تحتاج رسماً كاملاً للبدء."
    actions={[
      {
        variant: 'primary',
        text: 'تواصل عبر واتساب',
        href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'secondary',
        text: 'اطلب عرض سعر',
        href: 'https://ccfrp.com/contact/',
        target: '_blank',
      },
    ]}
  />
</PageLayout>
