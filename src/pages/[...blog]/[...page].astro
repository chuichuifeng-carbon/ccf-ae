---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const breadcrumbs = [
  { text: 'Главная', href: getPermalink('/') },
  ...(currentPage > 1
    ? [{ text: 'Блог', href: getBlogPermalink() }, { text: `Страница ${currentPage}` }]
    : [{ text: 'Блог' }]),
];

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `Блог${currentPage > 1 ? ` — Страница ${currentPage}` : ''}`,
  description:
    'Практические руководства по закупке карбоновых деталей: материал, применяемость, оптовая цена и производство CCF.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata} breadcrumbSchema={false}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="Руководства для оптовиков и дистрибьюторов: сравните материалы, подберите применение и оцените состав предложения до закупки."
    >
      Блог
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    <!--
      <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
      <PostTags tags={allTags}  title="Search by Tags:" />
    -->
  </section>
  <CallToAction
    title="Обсудите закупку карбоновых деталей с CCF"
    subtitle="Передайте данные автомобиля, выбранные детали, количество и место доставки. Команда CCF отвечает в рабочее время (GMT+8)."
    actions={[
      {
        variant: 'primary',
        text: 'Связаться в WhatsApp',
        href: 'https://wa.me/8613427690360?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%20CCF!%20%D0%A5%D0%BE%D1%87%D1%83%20%D0%BF%D0%BE%D0%BB%D1%83%D1%87%D0%B8%D1%82%D1%8C%20%D0%BE%D0%BF%D1%82%D0%BE%D0%B2%D0%BE%D0%B5%20%D0%BF%D1%80%D0%B5%D0%B4%D0%BB%D0%BE%D0%B6%D0%B5%D0%BD%D0%B8%D0%B5%20%D0%BD%D0%B0%20%D0%B2%D1%8B%D0%B1%D1%80%D0%B0%D0%BD%D0%BD%D1%8B%D0%B5%20%D0%BA%D0%B0%D1%80%D0%B1%D0%BE%D0%BD%D0%BE%D0%B2%D1%8B%D0%B5%20%D0%B4%D0%B5%D1%82%D0%B0%D0%BB%D0%B8.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'secondary',
        text: 'Запросить предложение',
        href: '/contact/',
        target: '_blank',
      },
    ]}
  />
</Layout>
