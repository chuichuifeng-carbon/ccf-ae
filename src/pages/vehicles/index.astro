---
import PageLayout from '~/layouts/PageLayout.astro';
import artwork from '~/data/b2b/site-artwork.json';
const metadata = {
  title: 'Подбор деталей BMW, Mercedes-AMG и Porsche | CCF',
  description:
    'Выберите марку автомобиля: каталог деталей BMW по кузовам, PDF-каталоги Mercedes-AMG и Porsche. Оптовый запрос производителю CCF.',
};
const brands = [
  { name: 'BMW', slug: 'bmw', description: 'Каталог деталей с фотографиями и фильтрами по кузову и типу детали.' },
  {
    name: 'Mercedes-AMG',
    slug: 'mercedes-amg',
    description: 'Каталоги моделей и подбор деталей по фотографии и номеру позиции.',
  },
  { name: 'Porsche', slug: 'porsche', description: 'Каталоги моделей и подбор деталей по поколению и комплектации.' },
];
---

<PageLayout metadata={metadata}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <p class="text-primary font-bold">ПОДБОР ПО АВТОМОБИЛЮ</p><h1 class="text-4xl md:text-5xl font-bold mt-3">
      Выберите марку автомобиля
    </h1><p class="text-lg text-muted mt-5 max-w-3xl">
      Начните с марки, затем укажите кузов, год выпуска и нужную деталь. Для расчёта оптовой цены подготовьте количество
      и город доставки.
    </p><div class="grid md:grid-cols-3 gap-6 mt-10">
      {
        brands.map((brand) => (
          <a
            href={`/vehicles/${brand.slug}/`}
            class="block overflow-hidden rounded-2xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 hover:border-primary transition"
          >
            <>
              <img
                src={artwork[brand.slug as keyof typeof artwork]}
                alt={brand.name}
                width="640"
                height="360"
                loading="lazy"
                class="w-full aspect-video object-cover"
              />
              <div class="p-6">
                <>
                  <h2 class="text-2xl font-bold">{brand.name}</h2>
                  <p class="text-muted mt-3">{brand.description}</p>
                  <p class="text-primary font-semibold mt-5">Перейти к подбору →</p>
                </>
              </div>
            </>
          </a>
        ))
      }
    </div>
  </section>
</PageLayout>
