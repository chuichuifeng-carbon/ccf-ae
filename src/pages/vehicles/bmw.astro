---
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import ProductCollection from '~/components/widgets/ProductCollection.astro';
import ModelCatalogs from '~/components/widgets/ModelCatalogs.astro';
import { allProducts } from '~/data/b2b/all-products';
import { categoryNamesRu } from '~/data/b2b/product-labels-ru';
const chassis = [...new Set(allProducts.flatMap((p) => p.chassisCodes))].sort();
const categories = [...new Set(allProducts.map((p) => p.categorySlug))];
const metadata = {
  title: 'Карбоновые детали BMW оптом — подбор по кузову | CCF',
  description:
    'Выберите кузов BMW G80, G82, G87, G90 или другой код. Фотографии деталей, фильтр по типу и запрос оптовой цены у производителя CCF.',
};
---

<PageLayout metadata={metadata}>
  <section class="max-w-[1720px] mx-auto px-4 sm:px-6 pt-12 pb-6">
    <a href="/vehicles/" class="text-primary">← Все марки</a>
    <p class="text-primary font-bold mt-7">BMW · ОПТОВЫЙ КАТАЛОГ</p>
    <h1 class="text-4xl md:text-5xl font-bold mt-3">Подберите детали для BMW</h1>
    <p class="text-lg text-muted max-w-4xl mt-5">
      Выберите код кузова и тип детали. Для подтверждения применяемости и расчёта цены отправьте год выпуска, фото
      автомобиля, количество и город доставки.
    </p>
    <nav class="flex flex-wrap gap-3 mt-6" aria-label="Популярные кузова BMW">
      {
        ['G80', 'G82', 'G87', 'G90', 'F80', 'F82'].map((code) => (
          <a
            class="rounded-full bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 px-5 py-2 hover:border-primary"
            href={`#bmw-${code}`}
          >
            BMW {code}
          </a>
        ))
      }
    </nav>
  </section>
  <section class="max-w-[1720px] mx-auto px-4 sm:px-6 py-6" aria-label="Фильтры каталога BMW">
    <div
      class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200 dark:border-slate-700 p-5 grid gap-4 md:grid-cols-4 items-end"
    >
      <label
        >Кузов<select data-filter-chassis aria-label="Кузов" class="block w-full mt-2 border rounded-lg p-3 bg-page"
          ><option value="">Все кузова</option>{chassis.map((code) => <option value={code}>{code}</option>)}</select
        ></label
      >
      <label
        >Тип детали<select
          data-filter-category
          aria-label="Тип детали"
          class="block w-full mt-2 border rounded-lg p-3 bg-page"
          ><option value="">Все детали</option>{
            categories.map((code) => <option value={code}>{categoryNamesRu[code] || code}</option>)
          }</select
        ></label
      >
      <label
        >Поиск<input
          type="search"
          data-filter-search
          aria-label="Поиск"
          maxlength="120"
          placeholder="G80, CSL, сплиттер"
          class="block w-full mt-2 border rounded-lg p-3 bg-page"
        /></label
      >
      <button type="button" data-filter-reset class="btn-secondary">Сбросить фильтры</button>
    </div>
    <p data-filter-status role="status" aria-live="polite" class="mt-4 text-muted">
      Всего товаров: {allProducts.length}
    </p>
    <p data-filter-empty hidden class="bg-white dark:bg-slate-900 rounded-xl p-6 mt-4">
      Нет подходящих товаров. Измените фильтры или <a href="https://wa.me/8613427690360" class="text-primary underline"
        >пришлите фото нужной детали</a
      >.
    </p>
    <noscript
      ><p class="mt-4 text-muted">
        Показан полный каталог. Для фильтрации включите JavaScript или воспользуйтесь поиском браузера.
      </p></noscript
    >
  </section>
  <ProductCollection title="Каталог деталей BMW" />
  <ModelCatalogs brand="bmw" />
  <section class="max-w-7xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold mb-4">Нужна помощь с подбором?</h2><p class="text-muted mb-5">
      Код кузова — отправная точка. Перед заказом согласуем комплектацию автомобиля, крепления и состав комплекта.
    </p><Button href="https://wa.me/8613427690360" text="Связаться в WhatsApp" variant="primary" target="_blank" />
  </section>
</PageLayout>
<script>
  import '~/scripts/bmw-filters';
</script>
