---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ProductCollection from '~/components/widgets/ProductCollection.astro';
import ModelCatalogs from '~/components/widgets/ModelCatalogs.astro';
import { allProducts, groupByChassis } from '~/data/b2b/all-products';

const metadata = {
  title: 'قطع كربون BMW M2 وM3 وM4 وM5 بالجملة | CCF',
  description:
    'كتالوجات قطع كربون بي إم دبليو BMW M2 وM3 وM4 وM5 وأجيال G وF المختارة. حدّد الطراز والشاسيه ومرجع القطعة لطلب عرض توريد من المصنع.',
};

// 按底盘分组，每个底盘最多取 6 个代表产品
const chassisGroups = groupByChassis(allProducts);
const CHASSIS_INFO_AR: Record<string, string> = {
  G80: 'M3 سيدان 2021-الآن',
  G82: 'M4 كوبيه 2021-الآن',
  G83: 'M4 كابريوليه 2022-الآن',
  G87: 'M2 كوبيه 2023-الآن',
  G90: 'M5 سيدان 2024-الآن',
  F80: 'M3 سيدان 2014-2020',
  F82: 'M4 كوبيه 2014-2020',
  F87: 'M2 كوبيه 2016-2021',
  F90: 'M5 سيدان 2017-2023',
};
const chassisCards = Object.entries(chassisGroups)
  .map(([code, products]) => ({
    code,
    label: CHASSIS_INFO_AR[code] || code,
    count: products.length,
    sample: products,
  }))
  .sort((a, b) => b.count - a.count);
---

<PageLayout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="تصفح حسب المركبة · BMW"
    title="قطع ألياف الكربون لسيارات BMW"
    subtitle="تصفّح قطع كربون فايبر بي إم دبليو BMW M2 وM3 وM4 وM5 وأجيال G وF المختارة. افتح كتالوج الطراز أدناه، ثم حدّد مرجع القطعة وسنة المركبة ونسخة الهيكل لطلب توريد بالجملة من مصنع CCF."
    callToAction={{
      text: 'تواصل عبر واتساب',
      href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
      target: '_blank',
      icon: 'tabler:brand-whatsapp',
      variant: 'primary',
    }}
    callToAction2={{
      text: 'اطلب عرض سعر بالجملة',
      href: 'https://ccfrp.com/contact/',
      target: '_blank',
      variant: 'secondary',
    }}
  />

  <ModelCatalogs brand="bmw" />
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <h2 class="text-2xl font-bold mb-4">اختر شاسيه سيارتك للوصول إلى مراجع القطع</h2>
    <nav aria-label="اختيار الشاسيه" class="flex flex-wrap gap-3">
      {
        chassisCards.map((card) => (
          <a class="text-primary underline" href={`#bmw-${card.code}`}>
            <bdi dir="ltr">BMW {card.code}</bdi>
          </a>
        ))
      }
    </nav>
    <p class="text-muted mt-4">
      راجع صور السيارة وتجهيزاتها قبل اعتماد المطابقة؛ أسماء الشاسيهات مراجع للاختيار وليست ضماناً لتوافق كل نسخة.
    </p>
  </section>
  {
    chassisCards.map((card) => (
      <section id={`bmw-${card.code}`} class="scroll-mt-24">
        <ProductCollection chassis={card.code} title={`قطع كربون BMW ${card.code}`} />
      </section>
    ))
  }

  <!-- Stats -->
  <Stats
    stats={[
      { amount: 'M2 · M3 · M4 · M5', title: 'تطبيقات M الرئيسية' },
      { amount: 'G · F', title: 'أجيال متعددة مغطاة' },
      { amount: 'كربون جاف', title: 'تركيز الإنتاج' },
    ]}
  />

  <!-- Covered models -->
  <Features2
    tagline="الطرازات المغطاة"
    title="طرازات BMW التي نغطيها"
    subtitle="تطبيقات M الحالية والسابقة، إضافة إلى الفئات الأساسية — توفر القطع يختلف حسب الطراز والجيل."
    columns={3}
    items={[
      {
        title: 'الجيل الحالي M',
        description: 'G80/G82 M3 و M4 · G87 M2 · G90 M5 — أوسع تغطية في كتالوجنا، بتصاميم CSL و MP و R44 وغيرها.',
        icon: 'tabler:car',
      },
      {
        title: 'الجيل السابق M',
        description: 'F80/F82/F83 M3 و M4 · F87 M2 · F90 M5 — قطع إيروديناميكية وألواح هيكل وأغطية مرايا.',
        icon: 'tabler:car',
      },
      {
        title: 'الفئات الأساسية',
        description:
          'G42 الفئة الثانية · G20/G28 و F30 الفئة الثالثة · G22/G23/G26 الفئة الرابعة · G30/G38 و G60/G68 الفئة الخامسة.',
        icon: 'tabler:car',
      },
    ]}
  />

  <!-- Popular part types -->
  <Features
    tagline="القطع الأكثر طلباً"
    title="قطع ألياف الكربون الشائعة لمركبات BMW"
    columns={3}
    defaultIcon="tabler:checkbox"
    items={[
      {
        title: 'الشفاه الأمامية',
        description: 'تصاميم CSL و R44 و V و MP لمركبات G80/G82 و G87 M2 و G90 M5 وأجيال F.',
        icon: 'tabler:wind',
      },
      {
        title: 'الناشرات الخلفية',
        description: 'تصاميم MP و 3D وإصدارات بإضاءة وسطية لمركبات M الحالية والسابقة.',
        icon: 'tabler:wind',
      },
      {
        title: 'التنانير الجانبية',
        description: 'تصاميم MP وبروفايل مسطح لمركبات G80/G82/G83 و G87 M2 و G90 M5.',
        icon: 'tabler:wind',
      },
      {
        title: 'الأجنحة والسبويلر',
        description: 'أجنحة MP و A-Style و AT-R3 وسبويلر CS لغطاء الصندوق.',
        icon: 'tabler:wind',
      },
      {
        title: 'أغطية المحرك وصناديق الأمتعة',
        description: 'أغطية محرك بتصاميم AC و APN وأغطية صناديق بتصميم CSL — بنسيج قياسي أو Forged Carbon.',
        icon: 'tabler:engine',
      },
      {
        title: 'الشبكات والزخارف',
        description: 'شبكات أمامية بتصاميم CSL و V و MP، شبكات كيدني، وأغطية مرايا بديلة.',
        icon: 'tabler:grill',
      },
    ]}
  />

  <aside class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <h2 class="text-2xl font-bold mb-3">هل اخترت المرجع المناسب لمركبتك؟</h2>
    <p class="text-lg text-muted">
      يوضح <a class="text-primary underline" href="/carbon-fiber-parts-fitment-check">دليل مراجعة التوافق قبل الطلب</a> صور
      المصد والعادم وبيانات المركبة التي تساعدنا على مراجعة النسخة المطلوبة.
    </p>
  </aside>

  <!-- Closing CTA -->
  <CallToAction
    layout="banner"
    title="اطلب عرض سعر لقطع BMW"
    subtitle='أرسل طراز مركبتك ورمز الشاسيه والقطعة المطلوبة والكمية. <a class="text-link underline" href="https://ccfrp.com/vehicles/bmw/" target="_blank" rel="noopener">تصفح قطع BMW الكاملة على الموقع الرئيسي ←</a>'
    actions={[
      {
        variant: 'primary',
        text: 'تواصل عبر واتساب',
        href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'secondary',
        text: 'اطلب عرض سعر بالجملة',
        href: 'https://ccfrp.com/contact/',
        target: '_blank',
      },
    ]}
  />
</PageLayout>
