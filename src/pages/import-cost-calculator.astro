---
import PageLayout from '~/layouts/PageLayout.astro';
import { whatsappUrl } from '~/utils/inquiry';
const title = 'Калькулятор стоимости импорта и валовой маржи';
const fields = [
  { key: 'factory', label: 'Цена производителя', value: '250' },
  { key: 'freight', label: 'Перевозка', value: '85' },
  { key: 'other', label: 'Прочие импортные расходы', value: '110' },
  { key: 'retail', label: 'Цена перепродажи', value: '599' },
];
---

<PageLayout
  metadata={{
    title: title + ' | CCF',
    description:
      'Оцените полную стоимость закупки и валовую маржу в USD: цена производителя, перевозка и прочие расходы. Калькулятор использует ваши суммы без текущих тарифов.',
  }}
  includeBuyerResources={false}
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-14 pb-8">
    <p class="text-primary font-bold">ИНСТРУМЕНТЫ B2B-ПОКУПАТЕЛЯ</p><h1 class="text-4xl md:text-5xl font-bold mt-4">
      {title}
    </h1><p class="text-lg text-muted max-w-4xl mt-5">
      До оптовой закупки сравните полную стоимость и валовой результат. Все суммы вводите в долларах США и на одной
      базе: за одну деталь или за весь заказ.
    </p>
  </section>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-10">
    <div
      data-import-calculator
      class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-3xl p-5 sm:p-8"
    >
      <h2 class="text-2xl font-bold">Рассчитайте стоимость и маржу</h2><p
        id="calculator-help"
        class="text-muted mt-3 mb-7"
      >
        Пример в USD не является предложением цены, текущим тарифом перевозки или налоговым расчётом. Введите свои суммы
        без разделителей тысяч; дробную часть можно отделять точкой или запятой.
      </p><div class="grid sm:grid-cols-2 gap-6">
        {
          fields.map((field) => (
            <div>
              <>
                <label for={`cost-${field.key}`} class="block font-semibold mb-2">
                  {field.label} (USD)
                </label>
                <input
                  id={`cost-${field.key}`}
                  data-cost-field={field.key}
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  value={field.value}
                  maxlength="16"
                  aria-describedby="calculator-help calculator-error"
                  class="w-full rounded-xl border border-gray-300 dark:border-slate-600 bg-page p-4 text-2xl focus:outline-none focus:ring-2 focus:ring-primary"
                />
              </>
            </div>
          ))
        }
      </div><p
        id="calculator-error"
        data-cost-error
        class="text-red-700 dark:text-red-300 text-sm mt-4 min-h-6"
        role="status"
      >
      </p><div class="border-t border-gray-200 dark:border-slate-700 mt-4 pt-6" aria-live="polite" aria-atomic="true">
        <dl class="grid sm:grid-cols-3 gap-6">
          {
            [
              ['landed', 'Полная стоимость', '445,00 $'],
              ['profit', 'Валовая прибыль', '154,00 $'],
              ['margin', 'Валовая маржа', '25,7%'],
            ].map(([key, label, value]) => (
              <div>
                <>
                  <dt class="text-muted mb-2">{label}</dt>
                  <dd data-cost-result={key} class="text-3xl font-bold">
                    {value}
                  </dd>
                </>
              </div>
            ))
          }
        </dl><p data-cost-note class="text-sm text-muted mt-5 min-h-5"></p>
      </div><button type="button" data-cost-reset class="btn-secondary w-full mt-6">Восстановить пример</button
      ><noscript
        ><p class="mt-4">
          Показан результат примера. Для других сумм включите JavaScript либо используйте формулы ниже.
        </p></noscript
      >
    </div><a
      class="btn-primary mt-6"
      href={whatsappUrl(
        'Предложение по деталям после расчёта стоимости импорта',
        'https://amxnx.vip/import-cost-calculator/'
      )}
      target="_blank"
      rel="noopener noreferrer">Запросить предложение CCF</a
    >
  </section>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-14 grid md:grid-cols-2 gap-8">
    <div>
      <h2 class="text-2xl font-bold mb-4">Формулы</h2><ul class="list-disc ps-5 space-y-3 text-muted">
        <li>Полная стоимость = цена производителя + перевозка + прочие импортные расходы.</li><li>
          Валовая прибыль = цена перепродажи − полная стоимость.
        </li><li>
          Валовая маржа = прибыль ÷ цена перепродажи × 100. Наценка рассчитывается от себестоимости и отличается от
          маржи.
        </li>
      </ul><p class="text-muted mt-4">
        В примере: 250 + 85 + 110 = 445 USD. При продаже за 599 USD валовая прибыль — 154 USD, маржа — около 25,7%. При
        нулевой выручке процент маржи не определяется.
      </p>
    </div><div>
      <h2 class="text-2xl font-bold mb-4">Что включить в прочие расходы</h2><p class="text-muted">
        Ваши оценки оформления, пошлин, местной доставки и дополнительной упаковки, если эти суммы ещё не включены в
        цену производителя или перевозчика. Инструмент не выбирает страну или код товара и не определяет ставки налогов.
      </p>
    </div><div>
      <h2 class="text-2xl font-bold mb-4">Одна деталь или весь заказ?</h2><p class="text-muted">
        Используйте одну базу для всех полей. Для одной детали распределите перевозку и расходы по выбранному правилу;
        для партии вводите общую стоимость и общую ожидаемую выручку. Детали разного объёма не всегда требуют равного
        распределения перевозки.
      </p>
    </div><div>
      <h2 class="text-2xl font-bold mb-4">Это не чистая прибыль</h2><p class="text-muted">
        Отдельно учтите комиссии, рекламу, возвраты, хранение и другие расходы. Введённые суммы не сохраняются и не
        отправляются отделу продаж или в события Analytics. Сообщение отправляете вы сами в WhatsApp.
      </p>
    </div><div class="md:col-span-2 flex flex-wrap gap-5 text-primary underline">
      <a href="/carbon-fiber-import-cost-profit-guide/">Разбор примера импорта</a><a
        href="/compare-wholesale-carbon-fiber-quotes/">Сравнение предложений</a
      ><a href="/catalogs/">Каталоги моделей</a><a href="/grow/wholesale/">Оптовые поставки</a>
    </div>
  </section>
</PageLayout>
<script>
  import { calculateImportCost, parseUsd } from '~/utils/importCost';
  function initializeCalculator() {
    document.querySelectorAll<HTMLElement>('[data-import-calculator]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const inputs = [...root.querySelectorAll<HTMLInputElement>('[data-cost-field]')];
      const result = (name: string) => root.querySelector<HTMLElement>(`[data-cost-result="${name}"]`)!;
      const error = root.querySelector<HTMLElement>('[data-cost-error]')!;
      const note = root.querySelector<HTMLElement>('[data-cost-note]')!;
      const money = new Intl.NumberFormat('ru-RU', { style: 'currency', currency: 'USD' });
      function update() {
        const values = inputs.map((input) => {
          const value = parseUsd(input.value);
          input.setAttribute('aria-invalid', String(value === null));
          return value;
        });
        const invalid = values.some((value) => value === null);
        error.textContent = invalid
          ? 'Введите сумму от 0 до 100 000 000, не более двух знаков после точки или запятой, без разделителей тысяч и символов валюты.'
          : '';
        if (invalid) {
          ['landed', 'profit', 'margin'].forEach((key) => {
            result(key).textContent = '—';
          });
          note.textContent = 'Исправьте значения, чтобы увидеть результат.';
          return;
        }
        const [factory, freight, other, retail] = values as number[];
        const costs = calculateImportCost(factory, freight, other, retail);
        result('landed').textContent = money.format(costs.landed / 100);
        result('profit').textContent = money.format(costs.profit / 100);
        result('margin').textContent =
          costs.margin === null
            ? '—'
            : `${costs.margin.toLocaleString('ru-RU', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}%`;
        note.textContent =
          costs.margin === null
            ? 'При нулевой выручке процент маржи не рассчитывается.'
            : costs.profit < 0
              ? 'Цена продажи ниже полной стоимости: показан валовой убыток.'
              : 'Это оценка валового результата до прочих расходов бизнеса.';
      }
      inputs.forEach((input) => input.addEventListener('input', update));
      root.querySelector('[data-cost-reset]')?.addEventListener('click', () => {
        inputs.forEach((input) => {
          input.value = input.defaultValue;
        });
        update();
      });
      update();
    });
  }
  document.addEventListener('astro:page-load', initializeCalculator);
</script>
