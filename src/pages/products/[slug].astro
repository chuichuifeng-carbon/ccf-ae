---
import PageLayout from '~/layouts/PageLayout.astro';
import ProductGallery from '~/components/widgets/ProductGallery.astro';
import Button from '~/components/ui/Button.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { allProducts, getRelatedProducts } from '~/data/b2b/all-products';
import { SITE } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import { whatsappUrl } from '~/utils/inquiry';
import { isolateLatin } from '~/utils/bidi';
import { TRADE_TERMS } from '~/data/b2b/trade-terms';
export function getStaticPaths() {
  return allProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const standardCarbon = Boolean(product.manufacturing);
const warranty = !standardCarbon ? 'اطلب تأكيد شروط ضمان هذا المرجع في عرض السعر.' : TRADE_TERMS.warranty;
const related = getRelatedProducts(product, 4);
const canonical = String(getCanonical(`/products/${product.slug}`));
const photo = product.images[0].lg;
const categoryUrl = `/products/${product.categorySlug}`;
const lastReviewed = product.reviewedAt;
const summary = `${product.categoryArShort} من الكربون الجاف الحقيقي لسيارات ${product.model}: تصميم أكثر عدوانية، وتوريد مباشر من مصنع CCF بالجملة أو OEM/ODM. تُؤكَّد المطابقة النهائية بصور سيارتك قبل عرض السعر.`;
const metadata = {
  title: product.seoTitle,
  description: product.seoDescription,
  ignoreTitleTemplate: true,
  canonical,
  openGraph: { images: [{ url: photo.url, width: photo.width, height: photo.height }] },
};
const faq = [
  { q: 'كيف أتأكد من المطابقة؟', a: `${product.checks[0]} ${product.checks[1]}` },
  {
    q: 'ما المادة ومحتويات التوريد؟',
    a: !standardCarbon
      ? product.checks[2]
      : 'اطلب تأكيد بنية الكربون والتشطيب ووحدة البيع والأقسام والمثبتات المشمولة للمرجع نفسه. صور المركبة قد تعرض إضافات لا تدخل في الطلب.',
  },
  {
    q: 'كيف أطلب سعر التوريد؟',
    a: 'أرسل اسم القطعة وسنة المركبة وصور الجزء الحالي والكمية وبلد ومدينة التسليم. تُؤكّد الكمية الدنيا والتكلفة ومدة التجهيز والشحن وفق الطلب.',
  },
  {
    q: 'ما الضمان وشروط الإرجاع؟',
    a: !standardCarbon
      ? warranty
      : 'قطع الكربون الجاف مشمولة بضمان سنة واحدة ضد عيوب التصنيع من تاريخ التسليم، ونتحمّل مسؤولية التلف أثناء النقل بالاستبدال أو إعادة الشحن بعد تأكيده بالصور. راجع سياسة الضمان والإرجاع للتفاصيل.',
  },
];
const commercialTerms = [
  ['الحد الأدنى للطلب', TRADE_TERMS.moq],
  ['مدة التجهيز', TRADE_TERMS.leadTime],
  ['التلف أثناء النقل', TRADE_TERMS.shippingDamage],
  ['الضمان', warranty],
];
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${canonical}#product`,
    name: product.title,
    description: product.description,
    url: canonical,
    image: product.images.map((image) => new URL(image.lg.url, SITE.site).toString()),
    brand: { '@type': 'Brand', name: 'CCF' },
    manufacturer: { '@id': `${SITE.site}/#organization` },
    category: product.categoryAr,
    material: !standardCarbon ? product.material || undefined : 'كربون جاف حقيقي (Dry Carbon Fiber)',
    keywords: product.keywords.join(', '),
    audience: {
      '@type': 'BusinessAudience',
      audienceType: 'موزعو قطع تعديل السيارات وورش التعديل ومشترو الجملة',
    },
    dateModified: lastReviewed,
    mainEntityOfPage: { '@id': `${canonical}#webpage` },
    additionalProperty: [
      {
        '@type': 'PropertyValue',
        name: 'مرجع المركبة؛ المطابقة تحتاج تأكيداً',
        value: product.chassisCodes.join(' / '),
      },
      ...(!standardCarbon ? [] : [{ '@type': 'PropertyValue', name: 'المادة', value: 'كربون جاف حقيقي — Dry Carbon' }]),
      { '@type': 'PropertyValue', name: 'التوريد', value: 'مصنع CCF — جملة / OEM-ODM' },
      { '@type': 'PropertyValue', name: 'بلد المنشأ', value: 'الصين — مصنع CCF' },
      ...(!standardCarbon ? [] : [{ '@type': 'PropertyValue', name: 'التصميم', value: 'تصميم أكثر عدوانية' }]),
      { '@type': 'PropertyValue', name: 'الحد الأدنى للطلب', value: TRADE_TERMS.moq },
      { '@type': 'PropertyValue', name: 'مدة التجهيز', value: TRADE_TERMS.leadTime },
      { '@type': 'PropertyValue', name: 'الضمان', value: warranty },
      { '@type': 'PropertyValue', name: 'التلف أثناء النقل', value: TRADE_TERMS.shippingDamage },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faq.map((entry) => ({
      '@type': 'Question',
      name: entry.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: entry.a.replace(/\s+/g, ' ').trim(),
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    name: product.title,
    url: canonical,
    inLanguage: 'ar',
    isPartOf: { '@id': `${SITE.site}/#website` },
    publisher: { '@id': `${SITE.site}/#organization` },
    mainEntity: { '@id': `${canonical}#product` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: SITE.site },
      { '@type': 'ListItem', position: 2, name: 'المنتجات', item: `${SITE.site}/products` },
      { '@type': 'ListItem', position: 3, name: product.categoryAr, item: `${SITE.site}${categoryUrl}` },
      { '@type': 'ListItem', position: 4, name: product.title, item: canonical },
    ],
  },
];
---

<PageLayout metadata={metadata} seoSchema={false} breadcrumbSchema={false}>
  <StructuredData slot="head" schema={schemas} />
  <nav aria-label="مسار التنقل" class="max-w-7xl mx-auto px-4 sm:px-6 pt-6 text-sm text-muted flex flex-wrap gap-2">
    <a href="/">الرئيسية</a><span aria-hidden="true">/</span><a href="/products">المنتجات</a><span aria-hidden="true"
      >/</span
    ><a href={categoryUrl}>{product.categoryAr}</a>
  </nav>
  <section
    class="max-w-7xl mx-auto px-4 sm:px-6 py-6 md:py-10 grid gap-x-10 gap-y-5 lg:grid-cols-[minmax(0,1.18fr)_minmax(0,1fr)] lg:items-start"
  >
    <div class="lg:col-start-2 lg:row-start-1">
      <p class="text-primary font-semibold">{product.categoryAr} · توريد للموزعين وورش التعديل</p>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight" set:html={isolateLatin(product.title)} />
    </div>
    <div class="min-w-0 lg:col-start-1 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-24">
      <ProductGallery product={product} />
    </div>
    <div class="min-w-0 space-y-5 lg:col-start-2 lg:row-start-2">
      <p class="text-lg text-muted" set:html={isolateLatin(product.description)} />
      <div class="flex flex-wrap gap-3">
        <Button
          href={whatsappUrl(product.title, canonical)}
          target="_blank"
          text="أرسل صور سيارتك واطلب سعر القطعة"
          icon="tabler:brand-whatsapp"
        /><Button href="/contact" variant="secondary" text="تواصل مع المبيعات" />
      </div>
      <p class="text-sm text-muted">السعر والتوفر يُؤكّدان حسب المرجع والكمية ووجهة الشحن.</p>
      <div id="trade-terms" class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
        <h2 class="font-bold mb-2">شروط التوريد</h2>
        <dl class="grid gap-3 sm:grid-cols-2 text-sm">
          {
            commercialTerms.map(([label, value]) => (
              <div>
                <dt class="font-medium mb-1">{label}</dt>
                <dd class="text-muted" set:html={isolateLatin(value)} />
              </div>
            ))
          }
        </dl>
      </div>
      <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
        <h2 class="font-bold mb-2">تحقّق من المرجع قبل الطلب</h2>
        <p class="text-sm text-muted mb-3">
          تطبيق المركبة مرجع للاختيار، والمطابقة النهائية تُؤكّد بصور السيارة وتجهيزاتها.
        </p>
        <table class="w-full text-sm text-start">
          <tbody
            >{
              product.specs.map(([label, value]) => (
                <tr>
                  <>
                    <th class="text-start py-2 pe-3 border-b border-gray-200 dark:border-slate-700 font-medium">
                      {label}
                    </th>
                    <td class="py-2 border-b border-gray-200 dark:border-slate-700" set:html={isolateLatin(value)} />
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </div>
  </section>
  {
    standardCarbon && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
        <div class="rounded-2xl border border-gray-200 dark:border-slate-700 p-5 md:p-6">
          <h2 class="text-xl font-bold mb-3">ملخص سريع</h2>
          <p class="text-muted" set:html={isolateLatin(summary)} />
          <ul class="list-disc ps-6 mt-3 text-sm text-muted space-y-1">
            <li>المادة: كربون جاف حقيقي — Dry Carbon؛ تُؤكَّد البنية والتشطيب للمرجع المطلوب.</li>
            <li>التوافق: مصمم لسيارات {product.model}؛ المطابقة النهائية تُؤكَّد بصور سيارتك وتجهيزاتها.</li>
            <li>التوريد: مصنع CCF — جملة أو OEM/ODM، مع تأكيد الكمية الدنيا والتغليف ووجهة الشحن.</li>
            <li>الطلب: أرسل سنة السيارة وصور الجزء الحالي والكمية ومدينة التسليم للحصول على عرض سعر.</li>
          </ul>
        </div>
        <div class="grid md:grid-cols-3 gap-4 mt-4">
          <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-5">
            <h3 class="font-bold mb-2">كربون جاف حقيقي</h3>
            <p class="text-sm text-muted">
              نبدأ من بنية كربون جاف حقيقية لا من طبقة زخرفية؛ تُؤكَّد البنية والتشطيب والوزن للمرجع قبل العرض.
            </p>
          </div>
          <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-5">
            <h3 class="font-bold mb-2">التحقّق من المطابقة</h3>
            <p class="text-sm text-muted">
              خطوط مستوحاة من المرجع الأصلي مع حضور أكثر عدوانية؛ تُؤكَّد نسخة المصد أو الرفرف ونقاط التثبيت بصور
              سيارتك.
            </p>
          </div>
          <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-5">
            <h3 class="font-bold mb-2">مصنع CCF بالجملة</h3>
            <p class="text-sm text-muted">
              توريد مباشر من المصنع للموزعين وورش التعديل، مع مسار OEM/ODM وتأكيد الكمية الدنيا والتغليف قبل الشحن.
            </p>
          </div>
        </div>
      </section>
    )
  }
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <h2 class="text-2xl font-bold mb-4">المطابقة ومحتويات التوريد</h2>
    <ul class="list-disc ps-6 space-y-3">{product.checks.map((check) => <li set:html={isolateLatin(check)} />)}</ul>
    <p class="mt-4 text-muted">
      يوصى بالتركيب لدى فني مختص. قد يلزم ضبط أو تجهيز حسب السيارة والقطعة؛ لا تعتمد وعداً بالتركيب دون تعديل قبل تأكيد
      المرجع.
    </p>
  </section>
  <section id="faq" class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <h2 class="text-2xl font-bold mb-5">أسئلة المشتري قبل التأكيد</h2>
    <div class="space-y-3">
      {
        faq.map((entry) => (
          <details class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
            <>
              <summary class="font-semibold cursor-pointer">{entry.q}</summary>
              <p class="text-muted pt-3" set:html={isolateLatin(entry.a)} />
            </>
          </details>
        ))
      }
    </div>
    <a href="/return-refund-policy" class="inline-block mt-4 text-primary underline">سياسة الضمان والإرجاع والاسترداد</a
    >
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <h2 class="text-2xl font-bold mb-5">جهّز طلباً أوضح قبل مقارنة السعر</h2>
    <div class="grid md:grid-cols-3 gap-4">
      <a
        href="/carbon-fiber-parts-fitment-check"
        class="rounded-xl border border-gray-200 dark:border-slate-700 p-5 text-primary underline"
        >ما الصور وبيانات المركبة التي تساعد على تأكيد المطابقة؟</a
      >
      <a
        href="/dry-carbon-vs-wet-carbon"
        class="rounded-xl border border-gray-200 dark:border-slate-700 p-5 text-primary underline"
        >كيف تراجع مادة الكربون الجاف والرطب للمرجع المطلوب؟</a
      >
      <a
        href="/import-cost-calculator"
        class="rounded-xl border border-gray-200 dark:border-slate-700 p-5 text-primary underline"
        >قدّر تكلفة الوصول والربح بأرقام عرض السعر والشحن</a
      >
    </div>
    <p class="mt-4 text-muted">
      للمخزون وإعادة الطلب راجع <a class="text-primary underline" href="/grow/wholesale">التوريد بالجملة</a>؛ ولتصميم
      جديد راجع <a class="text-primary underline" href="/grow/oem-odm">تطوير OEM/ODM</a>.
    </p>
  </section>
  {
    related.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
        <h2 class="text-2xl font-bold mb-5">قارن مراجع قريبة أو أكمل قائمة سيارتك</h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {related.map((item) => (
            <a
              href={`/products/${item.slug}`}
              class="rounded-xl overflow-hidden border border-gray-200 dark:border-slate-700"
            >
              <img
                src={item.featuredSm}
                alt={item.title}
                width={item.images[0].sm.width}
                height={item.images[0].sm.height}
                loading="lazy"
                sizes="(max-width: 767px) 50vw, 25vw"
                class="w-full aspect-square object-contain bg-black"
              />
              <h3 class="font-semibold p-4" set:html={isolateLatin(item.title)} />
            </a>
          ))}
        </div>
      </section>
    )
  }
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8 text-sm text-muted space-y-3">
    <h2 class="text-lg font-bold">المصدر ومسؤولية المعلومات</h2>
    <p>
      الجهة الناشرة: <a href="/about#publisher" class="text-primary underline">CCF</a>. الصور والمرجع تساعد على اختيار
      القطعة، والمادة والمطابقة ومحتويات الطلب تُؤكّد قبل الشراء. {
        lastReviewed && (
          <span>
            آخر مراجعة: <time datetime={lastReviewed}>{lastReviewed}</time>.
          </span>
        )
      }
    </p>
    <p>BMW وMercedes-Benz وPorsche علامات لأصحابها. تستخدم الأسماء لتحديد تطبيق المركبة؛ لا تدل على شراكة مع CCF.</p>
    <div class="flex flex-wrap gap-4">
      <a href="/editorial-policy" class="text-primary underline">المصادر والتصحيحات</a><a
        href="/catalogs"
        class="text-primary underline">كتالوجات المركبات</a
      ><a href={categoryUrl} class="text-primary underline">جميع مراجع هذه الفئة</a><a
        href="/vehicles/bmw"
        class="text-primary underline">اختيار قطع BMW حسب الشاسيه</a
      >
    </div>
  </section>
</PageLayout>
