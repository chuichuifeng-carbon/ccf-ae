---
import PageLayout from '~/layouts/PageLayout.astro';
import ProductGallery from '~/components/widgets/ProductGallery.astro';
import Button from '~/components/ui/Button.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { Icon } from 'astro-icon/components';
import { allProducts, getRelatedProducts } from '~/data/b2b/all-products';
import type { ProductSpecs16 } from '~/data/b2b/all-products-types';
import { packagingGallery, customizationGallery } from '~/data/b2b/shared-assets';
import { SITE } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import { whatsappUrl } from '~/utils/inquiry';
import { isolateLatin } from '~/utils/bidi';

export function getStaticPaths() {
  return allProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const canonical = String(getCanonical(`/products/${product.slug}`));
const categoryUrl = `/products/${product.categorySlug}`;
const related = getRelatedProducts(product, 4);
const photo = product.images[0].lg;
const videoId =
  product.youtube?.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|shorts\/|embed\/))([\w-]{11})/)?.[1] || '';

const metadata = {
  title: product.seoTitle,
  description: product.seoDescription,
  ignoreTitleTemplate: true,
  canonical,
  openGraph: { images: [{ url: photo.url, width: photo.width, height: photo.height }] },
};

const specs: ProductSpecs16 =
  product.specs16 ??
  ({
    productType: product.partTypeEn ?? product.partType,
    fitment: product.model,
    material: product.material,
    weave: 'نسج 3K — Twill 2×2 أو Plain 1×1 حسب الطلب.',
    finish: 'لامع (Gloss) أو مطفي (Matte) عند الطلب.',
    process: product.manufacturing,
    weight: 'يُوزَن المرجع المحدد ويُثبَّت في عرض السعر.',
    thickness: 'تُقاس نقاط التثبيت والحواف وتُثبَّت في عرض السعر.',
    installation: 'تركيب مباشر على نقاط التثبيت الأصلية بعد تأكيد المطابقة.',
    moq: 'عينة واحدة (MOQ = 1).',
    sampleLeadTime: 'تُؤكَّد بعد اعتماد المرجع.',
    bulkLeadTime: '25–30 يوماً من تأكيد الطلب.',
    customization: 'شعار مخصص، ألوان، تغليف مخصص، وقالب خاص (OEM/ODM).',
    packaging: 'كيس هوائي وإسفنج، ثم كرتون مقوّى، ثم صندوق خشبي للشحنات الكبيرة.',
    warranty: 'ضمان سنة واحدة على عيوب التصنيع.',
    damage: 'استبدال أو إعادة شحن بعد تأكيد التلف بالصور.',
  } satisfies ProductSpecs16);

type SpecKey = keyof ProductSpecs16;
const specGroups: Array<{ title: string; rows: Array<[SpecKey, string, string]> }> = [
  {
    title: 'المواصفات الفنية والمواد',
    rows: [
      ['productType', 'نوع المنتج', 'Product Type'],
      ['material', 'المادة', 'Material'],
      ['weave', 'نمط النسج', 'Weave'],
      ['finish', 'التشطيب', 'Finish'],
      ['process', 'عملية التصنيع', 'Manufacturing Process'],
      ['weight', 'الوزن', 'Weight'],
      ['thickness', 'السماكة', 'Thickness'],
    ],
  },
  {
    title: 'التوافق والتركيب',
    rows: [
      ['fitment', 'التوافق', 'Fitment'],
      ['installation', 'التركيب', 'Installation'],
    ],
  },
  {
    title: 'التوريد والتخصيص والضمان',
    rows: [
      ['moq', 'الحد الأدنى للطلب', 'MOQ'],
      ['sampleLeadTime', 'مدة العينة', 'Sample Lead Time'],
      ['bulkLeadTime', 'مدة الإنتاج بالجملة', 'Bulk Lead Time'],
      ['customization', 'التخصيص', 'Customization'],
      ['packaging', 'التغليف', 'Packaging'],
      ['warranty', 'الضمان', 'Warranty'],
      ['damage', 'التلف أثناء النقل', 'Transport Damage'],
    ],
  },
];

const quickFacts = [
  { icon: 'tabler:package', label: 'الحد الأدنى', value: 'عينة واحدة (MOQ = 1)' },
  { icon: 'tabler:clock-hour-4', label: 'عينة', value: 'تُؤكَّد بعد اعتماد المرجع' },
  { icon: 'tabler:truck-delivery', label: 'إنتاج بالجملة', value: '25–30 يوماً' },
  { icon: 'tabler:shield-check', label: 'الضمان', value: 'سنة واحدة' },
];

const highlights = product.highlights?.length
  ? product.highlights
  : [
      'كربون جاف حقيقي (DCF) وليس طبقة زخرفية',
      `مطابقة مصممة لهيكل ${product.model}`,
      'تشطيب لامع أو مطفي حسب الطلب',
      'توريد بالجملة مع شعار وتغليف مخصص',
    ];

const packagingSteps = [
  { icon: 'tabler:box-seam', title: 'حماية فردية', text: 'كيس هوائي أو إسفنج لكل قطعة لمنع الاحتكاك.' },
  { icon: 'tabler:package-export', title: 'كرتون مقوّى', text: 'كرتون تصدير بزوايا حماية وجدران مزدوجة.' },
  { icon: 'tabler:stack-2', title: 'تثبيت داخلي', text: 'فواصل وتثبيت يمنع حركة القطع داخل الكرتون.' },
  { icon: 'tabler:building-factory-2', title: 'شحن بحري', text: 'صندوق خشبي أو منصة نقالة للشحنات الكبيرة.' },
];

const isLighting = product.categorySlug === 'lighting';
const isAbsPart = /ABS/i.test(product.materialEn ?? '');
const customizationOptions = [
  { icon: 'tabler:brand-whatsapp', title: 'شعار مخصص', text: 'شعار علامتك على القطعة أو التغليف أو كيس الغبار.' },
  {
    icon: 'tabler:palette',
    title: 'لون وتشطيب',
    text: isLighting
      ? specs.finish
      : isAbsPart
        ? 'أسود لامع قياسي؛ يُؤكَّد التشطيب المطفي واللون قبل الطلب.'
        : 'لامع أو مطفي، ولمسات لون مخصصة حسب الطلب.',
  },
  ...(isAbsPart || isLighting
    ? []
    : [{ icon: 'tabler:grid-dots', title: 'نمط النسج', text: 'Twill 2×2 أو Plain 1×1 — يُؤكَّد للمرجع.' }]),
  { icon: 'tabler:box', title: 'تغليف مخصص', text: 'كرتون بطباعة علامتك وملصقات ومعلومات توريد.' },
  { icon: 'tabler:tool', title: 'قالب خاص', text: 'تطوير قالب لموديل جديد ضمن OEM/ODM.' },
];

const faq = product.faq?.length
  ? product.faq
  : [
      { q: 'كيف أتأكد من المطابقة؟', a: product.checks[0] },
      { q: 'ما المادة ومحتويات التوريد؟', a: product.checks[2] },
      {
        q: 'كيف أطلب سعر التوريد؟',
        a: 'أرسل اسم القطعة وسنة المركبة وصور الجزء الحالي والكمية وبلد ومدينة التسليم.',
      },
      { q: 'ما الضمان وشروط الإرجاع؟', a: specs.warranty },
    ];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${canonical}#product`,
    name: product.title,
    description: product.description,
    url: canonical,
    image: product.images.map((image) => new URL(image.lg.url, SITE.site).toString()),
    brand: { '@type': 'Brand', name: 'CCF' },
    manufacturer: { '@id': `${SITE.site}/#organization` },
    category: product.categoryAr,
    material: product.materialEn || undefined,
    keywords: product.keywords.join(', '),
    audience: {
      '@type': 'BusinessAudience',
      audienceType: 'موزعو قطع تعديل السيارات وورش التعديل ومشترو الجملة',
    },
    dateModified: product.reviewedAt,
    mainEntityOfPage: { '@id': `${canonical}#webpage` },
    additionalProperty: [
      { '@type': 'PropertyValue', name: 'Fitment', value: product.model },
      ...(product.materialEn ? [{ '@type': 'PropertyValue', name: 'Material', value: product.materialEn }] : []),
      ...specGroups.flatMap((group) =>
        group.rows.map(([key, label]) => ({
          '@type': 'PropertyValue',
          name: label,
          value: specs[key],
        }))
      ),
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: product.title,
    inLanguage: 'ar',
    isPartOf: { '@id': `${SITE.site}/#website` },
    publisher: { '@id': `${SITE.site}/#organization` },
    mainEntity: { '@id': `${canonical}#product` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faq.map((entry) => ({
      '@type': 'Question',
      name: entry.q,
      acceptedAnswer: { '@type': 'Answer', text: entry.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: SITE.site },
      { '@type': 'ListItem', position: 2, name: 'المنتجات', item: `${SITE.site}/products` },
      { '@type': 'ListItem', position: 3, name: product.categoryAr, item: `${SITE.site}${categoryUrl}` },
      { '@type': 'ListItem', position: 4, name: product.title, item: canonical },
    ],
  },
];
---

<PageLayout metadata={metadata} seoSchema={false} breadcrumbSchema={false}>
  <StructuredData slot="head" schema={schemas} />

  <nav aria-label="مسار التنقل" class="max-w-7xl mx-auto px-4 sm:px-6 pt-6 text-sm text-muted flex flex-wrap gap-2">
    <a href="/">الرئيسية</a><span aria-hidden="true">/</span><a href="/products">المنتجات</a><span aria-hidden="true"
      >/</span
    ><a href={categoryUrl}>{product.categoryAr}</a>
  </nav>

  <section
    class="max-w-7xl mx-auto px-4 sm:px-6 py-6 md:py-10 grid gap-x-10 gap-y-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-start"
  >
    <div class="lg:col-start-2 lg:row-start-1">
      <p class="text-primary font-semibold">
        {product.categoryAr} · توريد للموزعين وورش التعديل
      </p>
      <h1 class="text-2xl md:text-3xl font-bold leading-snug mt-1" set:html={isolateLatin(product.title)} />
      <p class="mt-2 text-lg font-medium text-muted" dir="ltr"><bdi>{product.model}</bdi></p>
    </div>

    <div class="min-w-0 lg:col-start-1 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-24">
      <ProductGallery product={product} />
    </div>

    <div class="min-w-0 space-y-5 lg:col-start-2 lg:row-start-2">
      <p class="text-lg text-muted" set:html={isolateLatin(product.description)} />

      <ul class="grid gap-2 sm:grid-cols-2">
        {
          highlights.map((item) => (
            <li class="flex items-start gap-2 text-sm">
              <Icon name="tabler:circle-check" class="size-5 shrink-0 text-primary" />
              <span set:html={isolateLatin(item)} />
            </li>
          ))
        }
      </ul>

      <div class="flex flex-wrap gap-3">
        <Button
          href={whatsappUrl(product.title, canonical)}
          target="_blank"
          text="أرسل صور سيارتك واطلب سعر القطعة"
          icon="tabler:brand-whatsapp"
        />
        <Button href="/contact" variant="secondary" text="طلب عرض سعر رسمي" />
      </div>
      <p class="text-sm text-muted">السعر والتوفر يُؤكّدان حسب المرجع والكمية ووجهة الشحن.</p>

      <dl class="grid grid-cols-2 gap-3 rounded-xl border border-gray-200 dark:border-slate-700 p-4 text-sm">
        {
          quickFacts.map((fact) => (
            <div>
              <dt class="flex items-center gap-1.5 text-muted">
                <Icon name={fact.icon} class="size-4" />
                {fact.label}
              </dt>
              <dd class="font-medium mt-0.5" set:html={isolateLatin(fact.value)} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    videoId && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="video-title">
        <div class="rounded-2xl border border-gray-200 dark:border-slate-700 p-5 md:p-7 grid gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-center">
          <div class="overflow-hidden rounded-xl bg-black aspect-video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${videoId}`}
              title={`فيديو المنتج — ${product.title}`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="h-full w-full border-0"
            />
          </div>
          <div>
            <h2 id="video-title" class="text-xl md:text-2xl font-bold mb-2">
              فيديو المنتج
            </h2>
            <p class="text-muted mb-3">
              شاهد القطعة على السيارة قبل الطلب: التصميم والتشطيب والمطابقة على هيكل {product.model}.
            </p>
            <ul class="text-sm text-muted space-y-1 list-disc ps-5">
              <li>الفيديو مرجع بصري؛ المطابقة النهائية تُؤكَّد بصور سيارتك.</li>
              <li>التشطيب الظاهر في الفيديو قد يختلف حسب الطلب (لامع أو مطفي).</li>
              <li>اطلب صوراً ومقاطع إضافية للمرجع نفسه عبر واتساب.</li>
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="specs-title">
    <h2 id="specs-title" class="text-xl md:text-2xl font-bold mb-1">المواصفات الكاملة</h2>
    <p class="text-muted mb-5">
      الحقول التي لا ترد في ملف المرجع تُطلب تأكيدها قبل عرض السعر — لا نعتمد أرقاماً تقديرية.
    </p>
    <div class="rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden">
      <table class="w-full text-sm text-start">
        <tbody>
          {
            specGroups.map((group) => (
              <>
                <tr class="bg-gray-50 dark:bg-slate-800/60">
                  <th colspan="2" class="text-start px-4 py-2 font-semibold">
                    {group.title}
                  </th>
                </tr>
                {group.rows.map(([key, labelAr, labelEn]) => (
                  <tr class="border-t border-gray-200 dark:border-slate-700">
                    <th scope="row" class="align-top text-start px-4 py-3 w-[34%] font-medium">
                      {labelAr}
                      <span class="block text-xs font-normal text-muted" dir="ltr">
                        {labelEn}
                      </span>
                    </th>
                    <td class="px-4 py-3 text-muted" set:html={isolateLatin(specs[key])} />
                  </tr>
                ))}
              </>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="packaging-title">
    <div class="rounded-2xl border border-gray-200 dark:border-slate-700 p-5 md:p-7">
      <h2 id="packaging-title" class="text-xl md:text-2xl font-bold mb-2">التغليف وحماية الشحن</h2>
      <p class="text-muted mb-5">
        تُغلَّف كل قطعة بشكل فردي قبل التصدير، لأن القطع مصقولة ومعرّضة للخدش. التغليف القياسي يشمل حماية فردية وكرتوناً
        مقوّى، ويُرقّى إلى صندوق خشبي أو منصة نقالة للشحنات الكبيرة.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          packagingGallery.map((image) => (
            <figure class="overflow-hidden rounded-xl border border-gray-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-900">
              <img
                src={image.url}
                width={image.width}
                height={image.height}
                alt={image.captionAr}
                loading="lazy"
                class="block w-full aspect-[4/3] object-cover"
              />
              <figcaption class="px-3 py-2 text-xs text-muted">{image.captionAr}</figcaption>
            </figure>
          ))
        }
      </div>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mt-5">
        {
          packagingSteps.map((step) => (
            <li class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
              <Icon name={step.icon} class="size-6 text-primary mb-2" />
              <h3 class="font-semibold text-sm">{step.title}</h3>
              <p class="text-sm text-muted mt-1">{step.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="text-sm text-muted mt-4">
        للإنتاج بالجملة يمكن طباعة شعار علامتك على الكرتون وإضافة ملصقات التوريد — راجع قسم التخصيص أدناه.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="customization-title">
    <div
      class="rounded-2xl border border-gray-200 dark:border-slate-700 p-5 md:p-7 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-center"
    >
      <div class="grid gap-3 content-start sm:grid-cols-2">
        {
          customizationGallery.map((image) => (
            <figure class="overflow-hidden rounded-xl border border-gray-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-900">
              <img
                src={image.url}
                width={image.width}
                height={image.height}
                alt={image.captionAr}
                loading="lazy"
                class="block w-full aspect-[4/3] object-cover"
              />
              <figcaption class="px-3 py-2 text-xs text-muted">{image.captionAr}</figcaption>
            </figure>
          ))
        }
        <p class="text-xs text-muted sm:col-span-2">
          صور توضيحية لخدمة الشعار المخصص على القطعة وكيس الغبار والتغليف — يمكن طلب عينات إضافية.
        </p>
      </div>
      <div>
        <h2 id="customization-title" class="text-xl md:text-2xl font-bold mb-2">شعارك وتخصيصك — OEM / ODM</h2>
        <p class="text-muted mb-4">
          نورد لعلامات خاصة وموزعين: نطبع شعارك على القطعة أو كيس الغبار أو الكرتون، ونخصص اللون والتشطيب والتغليف. الحد
          الأدنى للتخصيص يُؤكَّد حسب نوع الشعار وعدد القطع.
        </p>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            customizationOptions.map((option) => (
              <li class="rounded-xl border border-gray-200 dark:border-slate-700 p-3">
                <div class="flex items-center gap-2 font-semibold text-sm">
                  <Icon name={option.icon} class="size-5 text-primary" />
                  {option.title}
                </div>
                <p class="text-sm text-muted mt-1">{option.text}</p>
              </li>
            ))
          }
        </ul>
        <div class="mt-4">
          <Button
            href={whatsappUrl(`طلب عينة بشعار مخصص — ${product.title}`, canonical)}
            target="_blank"
            text="اطلب عينة بشعارك"
            icon="tabler:brand-whatsapp"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="faq-title">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-start">
      <div>
        <h2 id="faq-title" class="text-xl md:text-2xl font-bold mb-2">أسئلة مشترو الجملة</h2>
        <p class="text-muted mb-4">
          المطابقة تُؤكَّد بصور السيارة قبل عرض السعر. أرسل سنة الصنع وإصدار السيارة والكمية ومدينة التسليم لتسريع
          العرض.
        </p>
        <ul class="text-sm text-muted space-y-1 list-disc ps-5">
          <li>عينة واحدة متاحة قبل الإنتاج بالجملة.</li>
          <li>تغليف تصدير مع حماية فردية لكل قطعة.</li>
          <li>ضمان سنة واحدة ضد عيوب التصنيع.</li>
          <li>استبدال أو إعادة شحن عند التلف أثناء النقل.</li>
        </ul>
      </div>
      <div class="space-y-3">
        {
          faq.map((entry) => (
            <details class="group rounded-xl border border-gray-200 dark:border-slate-700 p-4">
              <summary class="flex cursor-pointer items-center justify-between gap-3 font-semibold">
                <span set:html={isolateLatin(entry.q)} />
                <Icon
                  name="tabler:chevron-down"
                  class="size-5 shrink-0 text-muted transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-2 text-sm text-muted" set:html={isolateLatin(entry.a)} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="related-title">
        <h2 id="related-title" class="text-xl md:text-2xl font-bold mb-4">
          قطع أخرى من نفس العائلة
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((entry) => (
            <a
              href={`/products/${entry.slug}`}
              class="group rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden hover:border-primary"
            >
              <img
                src={entry.featuredImage}
                alt={entry.title}
                width={600}
                height={450}
                loading="lazy"
                class="block w-full aspect-[4/3] object-contain bg-slate-100 dark:bg-slate-900"
              />
              <div class="p-3">
                <p class="text-xs text-muted">{entry.categoryAr}</p>
                <p class="font-medium text-sm mt-1 group-hover:text-primary" set:html={isolateLatin(entry.title)} />
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <div class="rounded-2xl bg-primary/5 border border-primary/20 p-6 md:p-8 text-center">
      <h2 class="text-xl md:text-2xl font-bold mb-2">اطلب عرض سعر لهذا المرجع</h2>
      <p class="text-muted mb-4">
        أرسل صور سيارتك وسنة الصنع والكمية وبلد التسليم، وسنؤكد المطابقة والسعر ومدة الإنتاج عبر واتساب.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <Button
          href={whatsappUrl(product.title, canonical)}
          target="_blank"
          text="واتساب المبيعات"
          icon="tabler:brand-whatsapp"
        />
        <Button href="/contact" variant="secondary" text="نموذج طلب رسمي" />
      </div>
    </div>
  </section>
</PageLayout>
