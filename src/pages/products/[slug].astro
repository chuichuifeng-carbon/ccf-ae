---
import PageLayout from '~/layouts/PageLayout.astro';
import ProductGallery from '~/components/widgets/ProductGallery.astro';
import Button from '~/components/ui/Button.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { allProducts, getRelatedProducts } from '~/data/b2b/all-products';
import type { ProductSpecs16 } from '~/data/b2b/all-products-types';
import { packagingGallery, customizationGallery } from '~/data/b2b/shared-assets';
import { SITE } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import { whatsappUrl } from '~/utils/inquiry';
import { productReference } from '~/utils/product-reference';
export function getStaticPaths() {
  return allProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const canonical = String(getCanonical(`/products/${product.slug}`));
const categoryUrl = `/products/${product.categorySlug}`;
const related = getRelatedProducts(product, 4);
const specs = product.specs16!;
const siteReference = productReference(product.slug);
const accVersion = /без ACC/.test(product.title) ? 'Без ACC' : /с ACC/.test(product.title) ? 'С ACC' : '';
const sectionVersion = product.title.match(/(?:^|\s)([123]) част(?:ь|и)(?:\s|$)/)?.[1];
const quoteFields = new Set(['weight', 'thickness', 'sampleLeadTime']);
const videoId =
  product.youtube?.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|shorts\/|embed\/))([\w-]{11})/)?.[1] || '';
const metadata = {
  title: product.seoTitle,
  description: product.seoDescription,
  ignoreTitleTemplate: true,
  canonical,
  openGraph: {
    images: [{ url: product.images[0].lg.url, width: product.images[0].lg.width, height: product.images[0].lg.height }],
  },
};
const specLabels: Record<keyof ProductSpecs16, string> = {
  productType: 'Тип детали',
  fitment: 'Применяемость',
  material: 'Материал',
  weave: 'Переплетение',
  finish: 'Отделка',
  process: 'Производство',
  weight: 'Масса',
  thickness: 'Толщина',
  installation: 'Установка',
  moq: 'Минимальный заказ',
  sampleLeadTime: 'Срок образца',
  bulkLeadTime: 'Серийный заказ',
  customization: 'Персонализация',
  packaging: 'Упаковка',
  warranty: 'Гарантия',
  damage: 'Повреждения при перевозке',
};
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${canonical}#product`,
    name: product.title,
    description: product.description,
    url: canonical,
    image: product.images.map((i) => new URL(i.lg.url, SITE.site).href),
    brand: { '@type': 'Brand', name: 'CCF' },
    manufacturer: { '@id': `${SITE.site}/#organization` },
    category: product.categoryAr,
    material: product.materialEn || undefined,
    keywords: product.keywords.join(', '),
    audience: { '@type': 'BusinessAudience', audienceType: 'Дистрибьюторы, тюнинг-ателье и оптовые покупатели' },
    dateModified: product.reviewedAt,
    mainEntityOfPage: { '@id': `${canonical}#webpage` },
    additionalProperty: Object.entries(specs).map(([key, value]) => ({
      '@type': 'PropertyValue',
      name: specLabels[key as keyof ProductSpecs16],
      value,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: product.title,
    inLanguage: 'ru',
    isPartOf: { '@id': `${SITE.site}/#website` },
    publisher: { '@id': `${SITE.site}/#organization` },
    mainEntity: { '@id': `${canonical}#product` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: product.faq!.map((entry) => ({
      '@type': 'Question',
      name: entry.q,
      acceptedAnswer: { '@type': 'Answer', text: entry.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Главная', item: SITE.site },
      { name: 'Каталог', item: `${SITE.site}/products/` },
      { name: product.categoryAr, item: new URL(categoryUrl, SITE.site).href },
      { name: product.title, item: canonical },
    ].map((entry, index) => ({ '@type': 'ListItem', position: index + 1, ...entry })),
  },
];
---

<PageLayout metadata={metadata} seoSchema={false} breadcrumbSchema={false}>
  <StructuredData slot="head" schema={schemas} />
  <nav aria-label="Хлебные крошки" class="max-w-7xl mx-auto px-4 sm:px-6 pt-7 text-sm text-muted flex flex-wrap gap-2">
    <a href="/">Главная</a><span>/</span><a href="/products/">Каталог</a><span>/</span><a href={categoryUrl}
      >{product.categoryAr}</a
    >
  </nav>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8 grid gap-8 lg:grid-cols-2 items-start">
    <div class="lg:col-start-2 lg:row-start-1">
      <p class="text-primary font-bold mb-3">{product.categoryAr} · B2B</p><h1
        class="text-3xl md:text-4xl font-bold leading-tight"
      >
        {product.title}
      </h1><p class="text-muted mt-4">{product.model}</p><p class="text-sm text-muted mt-2">
        Код позиции на сайте: <strong>{siteReference}</strong>
      </p>
    </div>
    <div class="lg:col-start-1 lg:row-span-2 lg:row-start-1 min-w-0"><ProductGallery product={product} /></div>
    <div class="lg:col-start-2">
      <p class="text-muted leading-relaxed">{product.description}</p><ul class="space-y-2 mt-5 list-disc ps-5">
        {product.highlights.map((text) => <li>{text}</li>)}
      </ul><div class="flex flex-wrap gap-3 mt-7">
        <button hidden type="button" data-rfq-add={product.slug} data-rfq-title={product.title} class="btn-secondary"
          >В список запроса</button
        >
        <Button
          variant="primary"
          href={whatsappUrl(product.title, canonical)}
          text="Получить оптовую цену"
          icon="tabler:brand-whatsapp"
          target="_blank"
        /><Button variant="secondary" href="/contact/" text="Контакты отдела продаж" />
      </div><p class="text-sm text-muted mt-4">
        Для расчёта: год и комплектация автомобиля, фотографии, количество и город доставки.
      </p><dl class="grid grid-cols-2 gap-4 mt-6">
        {
          [
            ['Минимальный заказ', 'От 1 шт.'],
            ['Серийное производство', '25–30 дней'],
            ['Гарантия', '1 год'],
            ['Образец', 'Срок согласуется'],
          ].map(([label, value]) => (
            <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4">
              <>
                <dt class="text-sm text-muted">{label}</dt>
                <dd class="font-bold mt-2">{value}</dd>
              </>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
  {
    videoId && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="video-title">
        <>
          <h2 id="video-title" class="text-2xl font-bold mb-5">
            Видео детали
          </h2>
          <iframe
            class="w-full aspect-video rounded-2xl"
            src={`https://www.youtube-nocookie.com/embed/${videoId}`}
            title={`Видео — ${product.title}`}
            loading="lazy"
            allowfullscreen
          />
          <p class="text-sm text-muted mt-3">
            Уточните исполнение, комплектность и применяемость к вашему автомобилю перед заказом.
          </p>
        </>
      </section>
    )
  }
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="position-title">
    <h2 id="position-title" class="text-2xl font-bold mb-4">Позиция и исполнение</h2>
    <dl class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        [
          ['Код сайта', siteReference],
          ['Модель и кузов', product.model],
          ...(accVersion ? [['Исполнение ACC', accVersion]] : []),
          ...(sectionVersion
            ? [['Обозначение конструкции', `${sectionVersion} ${sectionVersion === '1' ? 'часть' : 'части'}`]]
            : []),
        ].map(([label, value]) => (
          <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
            <>
              <dt class="text-sm text-muted">{label}</dt>
              <dd class="font-semibold mt-2">{value}</dd>
            </>
          </div>
        ))
      }
    </dl>
    <p class="text-sm text-muted mt-4">
      Код сайта помогает ссылаться на выбранную позицию и не является заводским SKU. Единица продажи, полный состав,
      крепёж и применяемость фиксируются в предложении.
    </p>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="specs-title">
    <h2 id="specs-title" class="text-2xl font-bold mb-5">Характеристики и условия поставки</h2><div
      class="rounded-2xl border border-gray-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-900"
    >
      <table class="w-full text-sm">
        <caption class="sr-only">Характеристики {product.title}</caption><tbody
          >{
            Object.entries(specs)
              .filter(([key]) => !quoteFields.has(key))
              .map(([key, value]) => (
                <tr class="border-b border-gray-200 dark:border-slate-700 last:border-b-0">
                  <>
                    <th scope="row" class="text-start align-top p-4 w-[34%] font-semibold">
                      {specLabels[key as keyof ProductSpecs16]}
                    </th>
                    <td class="p-4 text-muted break-words">{value}</td>
                  </>
                </tr>
              ))
          }</tbody
        >
      </table>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <details class="rounded-xl border border-gray-200 dark:border-slate-700 p-5">
      <summary class="font-semibold cursor-pointer">Что согласуем в коммерческом предложении</summary><p
        class="text-muted mt-4"
      >
        Точное исполнение и состав комплекта, массу детали, габариты и вес упаковки, срок образца, перевозку и расходы
        до согласованного места. {specs.weight}
        {specs.thickness}
        {specs.sampleLeadTime}
      </p><a href="/contact/#payment-shipping" class="text-primary underline inline-block mt-4"
        >USD, оплата, доставка и русскоязычная связь</a
      >
    </details>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="packaging-title">
    <h2 id="packaging-title" class="text-2xl font-bold mb-3">Упаковка для перевозки</h2><p class="text-muted mb-5">
      {specs.packaging}
    </p><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        packagingGallery.map((image) => (
          <figure class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden">
            <>
              <img
                src={image.url}
                width={image.width}
                height={image.height}
                alt={image.captionAr}
                loading="lazy"
                class="w-full aspect-[4/3] object-cover"
              />
              <figcaption class="p-3 text-sm text-muted">{image.captionAr}</figcaption>
            </>
          </figure>
        ))
      }
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="customization-title">
    <h2 id="customization-title" class="text-2xl font-bold mb-3">Ваш логотип и фирменная упаковка</h2><p
      class="text-muted mb-5"
    >
      {specs.customization} Минимальный объём персонализации зависит от вида логотипа и количества.
    </p><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        customizationGallery.map((image) => (
          <figure class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden">
            <>
              <img
                src={image.url}
                width={image.width}
                height={image.height}
                alt={image.captionAr}
                loading="lazy"
                class="w-full aspect-[4/3] object-cover"
              />
              <figcaption class="p-3 text-sm text-muted">{image.captionAr}</figcaption>
            </>
          </figure>
        ))
      }
    </div><div class="mt-5">
      <Button
        href={whatsappUrl(`Образец с логотипом — ${product.title}`, canonical)}
        text="Обсудить образец с логотипом"
        target="_blank"
        variant="primary"
      />
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="faq-title">
    <h2 id="faq-title" class="text-2xl font-bold mb-5">Вопросы оптовых покупателей</h2><div
      class="grid md:grid-cols-2 gap-4"
    >
      {
        product.faq!.map((entry) => (
          <details class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
            <>
              <summary class="font-semibold cursor-pointer">{entry.q}</summary>
              <p class="mt-3 text-muted">{entry.a}</p>
            </>
          </details>
        ))
      }
    </div>
  </section>
  {
    related.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="related-title">
        <>
          <h2 id="related-title" class="text-2xl font-bold mb-5">
            Другие варианты для подбора
          </h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {related.map((entry) => (
              <a
                href={`/products/${entry.slug}/`}
                class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden hover:border-primary"
              >
                <img
                  src={entry.featuredImage}
                  alt={entry.title}
                  width={600}
                  height={450}
                  loading="lazy"
                  class="w-full aspect-[4/3] object-contain bg-white"
                />
                <div class="p-4">
                  <p class="text-xs text-muted">{entry.categoryAr}</p>
                  <h3 class="font-semibold mt-2">{entry.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </>
      </section>
    )
  }
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" aria-label="Материалы для заказа">
    <h2 class="text-2xl font-bold mb-5">Продолжить подбор и подготовить заказ</h2><div
      class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3"
    >
      {
        [
          [categoryUrl, product.categoryAr],
          ['/vehicles/bmw/', 'Подобрать BMW по кузову'],
          ['/grow/wholesale/', 'Оптовые поставки'],
          ['/grow/oem-odm/', 'Разработка OEM/ODM'],
          ['/contact/', 'Контакты CCF'],
        ].map(([href, label]) => (
          <a
            href={href}
            class="rounded-xl border border-gray-200 dark:border-slate-700 p-4 text-primary hover:underline"
          >
            {label} →
          </a>
        ))
      }
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <div class="rounded-2xl bg-primary text-white p-7 md:p-10">
      <h2 class="text-2xl font-bold">Получите предложение на эту деталь</h2><p class="mt-4 mb-6">
        Отправьте фото автомобиля, год, количество и город доставки. Согласуем применяемость, цену, состав комплекта и
        сроки.
      </p><Button
        href={whatsappUrl(product.title, canonical)}
        text="Отправить запрос в WhatsApp"
        target="_blank"
        class="bg-white border-white text-black hover:bg-gray-100"
        variant="secondary"
      />
    </div>
  </section>
</PageLayout>
