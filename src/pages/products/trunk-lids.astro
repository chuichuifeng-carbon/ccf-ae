---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ProductCollection from '~/components/widgets/ProductCollection.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'غطاء صندوق أمتعة كربون BMW M2 وM3 وM4 وM5 | CCF',
  description:
    'تصفّح أغطية شنطة وصندوق أمتعة كربون لتطبيقات BMW M2 وM3 وM4 وM5 المختارة. أكّد الهيكل والقفل والتجهيزات ومحتويات التوريد قبل طلب سعر الجملة.',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="فئة المنتجات · ألواح الهيكل"
    title="أغطية صندوق الأمتعة كربون لسيارات BMW"
    subtitle="تصفّح أغطية شنطة وصندوق أمتعة كربون لتطبيقات BMW F90 M5 وF87/G87 M2 وG80/G82 المختارة. اختر المرجع، ثم راجع الهيكل والقفل والكاميرا والتجهيزات التي ستُنقل إلى الغطاء قبل طلب التوريد."
    callToAction={{
      text: 'تواصل عبر واتساب',
      href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
      target: '_blank',
      icon: 'tabler:brand-whatsapp',
      variant: 'primary',
    }}
    callToAction2={{
      text: 'اطلب عرض سعر بالجملة',
      href: 'https://ccfrp.com/contact/',
      target: '_blank',
      variant: 'secondary',
    }}
  />

  <!-- Representative products -->
  <ProductCollection category="trunk-lids" title="صور وتصاميم أغطية صندوق الأمتعة" />

  <!-- Buyer checks -->
  <Features
    tagline="دليل المشتري"
    title="ما الذي تتحقق منه قبل اختيار غطاء صندوق أمتعة"
    columns={3}
    defaultIcon="tabler:checkbox"
    items={[
      {
        title: 'أكّد نمط الهيكل',
        description: 'سيدان أم كوبيه — أغطية الصناديق تختلف جذرياً بين تكوينات الهيكل حتى ضمن الطراز نفسه.',
        icon: 'tabler:car',
      },
      {
        title: 'أكّد نقاط التثبيت',
        description: 'المفصلات وآلية القفل — تحقق من توافقها مع مكونات مركبتك الأصلية.',
        icon: 'tabler:tools',
      },
      {
        title: 'أكّد نقل الملحقات',
        description: 'الأضواء والكاميرا والزخارف — أكّد ما يُنقل من الغطاء الأصلي وما هو مشمول في القطعة الجديدة.',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <!-- Closing CTA -->
  <CallToAction
    layout="banner"
    title="اطلب عرض سعر لأغطية صناديق الأمتعة"
    subtitle='أرسل مرجع المنتج وطراز مركبتك وسنتها والكمية المطلوبة. <a class="text-link underline" href="https://ccfrp.com/products/hoods-trunk-lids/#trunk-lids" target="_blank" rel="noopener">تصفح المجموعة الكاملة على الموقع الرئيسي ←</a>'
    actions={[
      {
        variant: 'primary',
        text: 'تواصل عبر واتساب',
        href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'secondary',
        text: 'اطلب عرض سعر بالجملة',
        href: 'https://ccfrp.com/contact/',
        target: '_blank',
      },
    ]}
  />
</PageLayout>
