---
import { getPageSeo } from '~/utils/seo';
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ProductCollection from '~/components/widgets/ProductCollection.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'أغطية مرايا كربون BMW F90 وF8x | CCF',
  description:
    'قارن أغطية مرايا كربون BMW F90 وF8x المختارة وخيارات النسيج والتصميم. أرسل صورة المرآة وسنة المركبة لتأكيد الغطاء البديل وطريقة التركيب والسعر.',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="فئة المنتجات · زخارف خارجية"
    title={getPageSeo(Astro.url.pathname)?.h1}
    subtitle={getPageSeo(Astro.url.pathname)?.description}
    callToAction={{
      text: 'تواصل عبر واتساب',
      href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
      target: '_blank',
      icon: 'tabler:brand-whatsapp',
      variant: 'primary',
    }}
    callToAction2={{
      text: 'اطلب عرض سعر بالجملة',
      href: 'https://ccfrp.com/contact/',
      target: '_blank',
      variant: 'secondary',
    }}
  />

  <!-- Representative products -->
  <ProductCollection category="mirror-caps" title="صور وتصاميم أغطية المرايا" />

  <!-- Buyer checks -->
  <Features
    tagline="دليل المشتري"
    title="ما الذي تتحقق منه قبل اختيار أغطية مرايا"
    columns={3}
    defaultIcon="tabler:checkbox"
    items={[
      {
        title: 'أكّد نوع هيكل المرآة',
        description: 'تصميم هيكل المرآة يختلف بين الأجيال والنسخ — أكّد طراز مركبتك وسنتها قبل الطلب.',
        icon: 'tabler:car',
      },
      {
        title: 'أكّد وحدة البيع',
        description: 'الأغطية تُباع عادةً كزوج يمين-يسار — أكّد المحتويات المشمولة في الطلب.',
        icon: 'tabler:tools',
      },
      {
        title: 'أكّد نوع القطعة',
        description: 'بديل كامل لهيكل المرآة أم غطاء إضافي فوق الأصل — طريقة التركيب والمظهر النهائي يختلفان.',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <!-- Closing CTA -->
  <CallToAction
    layout="banner"
    title="اطلب عرض سعر لأغطية المرايا"
    subtitle='أرسل مرجع المنتج وطراز مركبتك وسنتها والكمية المطلوبة. <a class="text-link underline" href="https://ccfrp.com/products/grilles-exterior-trim/#mirror-caps" target="_blank" rel="noopener">تصفح المجموعة الكاملة على الموقع الرئيسي ←</a>'
    actions={[
      {
        variant: 'primary',
        text: 'تواصل عبر واتساب',
        href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'secondary',
        text: 'اطلب عرض سعر بالجملة',
        href: 'https://ccfrp.com/contact/',
        target: '_blank',
      },
    ]}
  />
</PageLayout>
