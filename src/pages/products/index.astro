---
import PageLayout from '~/layouts/PageLayout.astro';
import ProductCollection from '~/components/widgets/ProductCollection.astro';
import { allProducts } from '~/data/b2b/all-products';
import { categoryNamesRu } from '~/data/b2b/product-labels-ru';
import { categoryDescriptionsRu } from '~/data/b2b/category-content-ru';
const metadata = {
  title: 'Каталог деталей BMW оптом — карбон, кузовные детали и оптика | CCF',
  description:
    '563 карточки деталей BMW от CCF: сплиттеры, диффузоры, капоты, зеркала, кузовные детали и оптика. Выберите категорию или кузов для оптового запроса.',
};
---

<PageLayout metadata={metadata}>
  <section class="max-w-[1720px] mx-auto px-4 sm:px-6 pt-12 pb-6">
    <p class="text-primary font-bold">CCF · КАТАЛОГ ДЛЯ БИЗНЕСА</p><h1 class="text-4xl md:text-5xl font-bold mt-3">
      Детали BMW по категориям
    </h1><p class="text-lg text-muted mt-5 max-w-4xl">
      {allProducts.length} карточки товаров с фотографиями. Выберите тип детали или <a
        href="/vehicles/bmw/"
        class="text-primary underline">подберите BMW по кузову</a
      >. Для Mercedes-AMG и Porsche доступны <a href="/catalogs/" class="text-primary underline">каталоги по моделям</a
      >.
    </p>
  </section>
  <section class="max-w-[1720px] mx-auto px-4 sm:px-6 py-8" aria-label="Категории деталей">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        Object.entries(categoryNamesRu).map(([slug, name]) => {
          const products = allProducts.filter((p) => p.categorySlug === slug);
          const photo = products[0].images[0].lg;
          return (
            <a
              href={`/products/${slug}/`}
              class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200 dark:border-slate-700 overflow-hidden hover:border-primary"
            >
              <>
                <img
                  src={photo.url}
                  width={photo.width}
                  height={photo.height}
                  alt={name}
                  loading="lazy"
                  class="w-full aspect-[4/3] object-contain bg-white"
                />
                <div class="p-5">
                  <>
                    <h2 class="text-xl font-bold">{name}</h2>
                    <p class="text-primary text-sm mt-2">Товаров: {products.length}</p>
                    <p class="text-muted text-sm mt-3">{categoryDescriptionsRu[slug]}</p>
                  </>
                </div>
              </>
            </a>
          );
        })
      }
    </div>
  </section>
  <ProductCollection title="Избранные исполнения из каталога" limit={12} />
</PageLayout>
