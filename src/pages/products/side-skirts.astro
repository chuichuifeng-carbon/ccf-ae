---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ProductCollection from '~/components/widgets/ProductCollection.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'عتبات جانبية كربون BMW ومرسيدس G63 | CCF',
  description:
    'قارن عتبات وتنانير كربون جانبية لتطبيقات BMW M ومرسيدس W465 G63 المختارة. أكّد الهيكل ووظيفة القطعة ومحتويات الطقم والكمية قبل طلب السعر.',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="فئة المنتجات · قطع إيروديناميكية"
    title="عتبات وتنانير جانبية كربون BMW ومرسيدس G63"
    subtitle="تصفّح قطع Side Skirts أسفل جانبي الهيكل، وتُسمّى أيضاً العتبات أو التنانير الجانبية. تشمل المجموعة تطبيقات BMW M وMercedes-Benz W465 G63؛ أكّد وظيفة القطعة ومحتويات الطقم حسب مرجع المنتج."
    callToAction={{
      text: 'تواصل عبر واتساب',
      href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
      target: '_blank',
      icon: 'tabler:brand-whatsapp',
      variant: 'primary',
    }}
    callToAction2={{
      text: 'اطلب عرض سعر بالجملة',
      href: 'https://ccfrp.com/contact/',
      target: '_blank',
      variant: 'secondary',
    }}
  />

  <!-- Representative products -->
  <ProductCollection category="side-skirts" title="صور وتصاميم القطع الجانبية" />

  <!-- Buyer checks -->
  <Features
    tagline="دليل المشتري"
    title="ما الذي تتحقق منه قبل اختيار تنانير جانبية"
    columns={3}
    defaultIcon="tabler:checkbox"
    items={[
      {
        title: 'أكّد بيانات المركبة',
        description:
          'الشاسيه، نمط الهيكل (سيدان / كوبيه / مكشوفة)، وقاعدة العجلات وتكوين العتبة — هذه العوامل تغيّر طول التنورة ومطابقتها.',
        icon: 'tabler:car',
      },
      {
        title: 'أكّد نوع القطعة',
        description: 'زوج يمين-يسار أم قطعة تمديد أم بديل كامل للعتبة الأصلية — وحدة البيع تختلف بين التصاميم.',
        icon: 'tabler:tools',
      },
      {
        title: 'أكّد طريقة التثبيت',
        description: 'نقاط التثبيت، المثبتات المشمولة، وما إذا كان التركيب يتطلب حفراً أو تعديلاً على العتبة الأصلية.',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <!-- Closing CTA -->
  <CallToAction
    layout="banner"
    title="اطلب عرض سعر للتنانير الجانبية"
    subtitle='أرسل مرجع المنتج وطراز مركبتك وسنتها والكمية المطلوبة. <a class="text-link underline" href="https://ccfrp.com/products/aero-parts/#side-skirts" target="_blank" rel="noopener">تصفح المجموعة الكاملة على الموقع الرئيسي ←</a>'
    actions={[
      {
        variant: 'primary',
        text: 'تواصل عبر واتساب',
        href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'secondary',
        text: 'اطلب عرض سعر بالجملة',
        href: 'https://ccfrp.com/contact/',
        target: '_blank',
      },
    ]}
  />
</PageLayout>
