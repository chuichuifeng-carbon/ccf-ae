---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ProductCollection from '~/components/widgets/ProductCollection.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'سبويلر وأجنحة خلفية كربون BMW M بالجملة | CCF',
  description:
    'اختر سبويلر أو جناحاً خلفياً كربون لسيارات BMW M المختارة. قارن التصميم وطريقة التثبيت ومحتويات التوريد، وأرسل المرجع والكمية لطلب سعر الجملة.',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="فئة المنتجات · قطع إيروديناميكية"
    title="سبويلر وأجنحة خلفية كربون لسيارات BMW M"
    subtitle="استعرض سبويلر وأجنحة خلفية لسيارات BMW M، تشمل تطبيقات G80/G82 وG87 M2 وF90 M5. أرسل مرجع التصميم ونسخة الهيكل لمراجعة نقاط التثبيت ومحتويات التوريد."
    callToAction={{
      text: 'تواصل عبر واتساب',
      href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
      target: '_blank',
      icon: 'tabler:brand-whatsapp',
      variant: 'primary',
    }}
    callToAction2={{
      text: 'اطلب عرض سعر بالجملة',
      href: 'https://ccfrp.com/contact/',
      target: '_blank',
      variant: 'secondary',
    }}
  />

  <!-- Representative products -->
  <ProductCollection category="spoilers-wings" title="صور وتصاميم السبويلر والأجنحة" />

  <!-- Buyer checks -->
  <Features
    tagline="دليل المشتري"
    title="ما الذي تتحقق منه قبل اختيار سبويلر أو جناح"
    columns={3}
    defaultIcon="tabler:checkbox"
    items={[
      {
        title: 'أكّد سطح التركيب',
        description: 'نمط الهيكل وسطح التثبيت — غطاء صندوق الأمتعة أم السقف — يحدد التصميم المتوافق مع مركبتك.',
        icon: 'tabler:car',
      },
      {
        title: 'أكّد نوع القطعة',
        description: 'قطعة إضافية فوق السبويلر الأصلي أم بديل كامل — طريقة التركيب والمظهر النهائي يختلفان.',
        icon: 'tabler:tools',
      },
      {
        title: 'أكّد متطلبات التثبيت',
        description: 'الأقواس والمثبتات المشمولة، وما إذا كان التركيب يتطلب حفراً في غطاء الصندوق الأصلي.',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <!-- Closing CTA -->
  <CallToAction
    layout="banner"
    title="اطلب عرض سعر للسبويلر والأجنحة"
    subtitle='أرسل مرجع المنتج وطراز مركبتك وسنتها والكمية المطلوبة. <a class="text-link underline" href="https://ccfrp.com/products/aero-parts/#spoilers-wings" target="_blank" rel="noopener">تصفح المجموعة الكاملة على الموقع الرئيسي ←</a>'
    actions={[
      {
        variant: 'primary',
        text: 'تواصل عبر واتساب',
        href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'secondary',
        text: 'اطلب عرض سعر بالجملة',
        href: 'https://ccfrp.com/contact/',
        target: '_blank',
      },
    ]}
  />
</PageLayout>
