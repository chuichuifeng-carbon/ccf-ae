---
import { getPageSeo } from '~/utils/seo';
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ProductCollection from '~/components/widgets/ProductCollection.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شفة أمامية وسبليتر كربون BMW M بالجملة | CCF',
  description:
    'قارن شفاه أمامية وسبليتر كربون BMW M بتصاميم CSL وR44 وMP المختارة. راجع المصد والمادة ومحتويات الطقم وأرسل المرجع والكمية لطلب سعر الجملة.',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="فئة المنتجات · قطع إيروديناميكية"
    title={getPageSeo(Astro.url.pathname)?.h1}
    subtitle={getPageSeo(Astro.url.pathname)?.description}
    callToAction={{
      text: 'تواصل عبر واتساب',
      href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
      target: '_blank',
      icon: 'tabler:brand-whatsapp',
      variant: 'primary',
    }}
    callToAction2={{
      text: 'اطلب عرض سعر بالجملة',
      href: 'https://ccfrp.com/contact/',
      target: '_blank',
      variant: 'secondary',
    }}
  />

  <!-- Representative products -->
  <ProductCollection category="front-lips-splitters" title="صور وتصاميم الشفاه الأمامية والسبليتر" />

  <!-- Buyer checks -->
  <Features
    tagline="دليل المشتري"
    title="ما الذي تتحقق منه قبل اختيار شفّة أمامية"
    columns={3}
    defaultIcon="tabler:checkbox"
    items={[
      {
        title: 'أكّد بيانات المركبة',
        description:
          'نسخة المصد، تحديث منتصف دورة الطراز (Facelift)، والزخارف السفلية الموجودة — اسم الطراز المشترك لا يضمن المطابقة.',
        icon: 'tabler:car',
      },
      {
        title: 'أكّد بنية القطعة',
        description: 'تصميم من قطعة واحدة أم متعدد القطع، نقاط التثبيت، والمثبتات المشمولة في الطلب.',
        icon: 'tabler:tools',
      },
      {
        title: 'أكّد المواصفة',
        description: 'المادة، التشطيب (لامع أو مطفي)، ووحدة البيع للنسخة المعروضة — صور المركبات قد تعرض قطعاً إضافية.',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <!-- Closing CTA -->
  <CallToAction
    layout="banner"
    title="اطلب عرض سعر للشفاه الأمامية"
    subtitle='أرسل مرجع المنتج وطراز مركبتك وسنتها والكمية المطلوبة. <a class="text-link underline" href="https://ccfrp.com/products/aero-parts/#front-lips" target="_blank" rel="noopener">تصفح المجموعة الكاملة على الموقع الرئيسي ←</a>'
    actions={[
      {
        variant: 'primary',
        text: 'تواصل عبر واتساب',
        href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'secondary',
        text: 'اطلب عرض سعر بالجملة',
        href: 'https://ccfrp.com/contact/',
        target: '_blank',
      },
    ]}
  />
</PageLayout>
