---
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import FeaturedProducts from '~/components/widgets/FeaturedProducts.astro';
import { allProducts } from '~/data/b2b/all-products';
import { categoryNamesRu } from '~/data/b2b/product-labels-ru';
import { whatsappUrl } from '~/utils/inquiry';
const metadata = {
  title: 'Карбоновые детали для автомобилей оптом из Китая | CCF',
  description:
    'Производство карбоновых деталей BMW, Mercedes-AMG и Porsche. Оптовые поставки и OEM/ODM для дистрибьюторов и тюнинг-ателье Центральной Азии.',
  ignoreTitleTemplate: true,
};
const brands = [
  { name: 'BMW', slug: 'bmw' },
  { name: 'Mercedes-AMG', slug: 'mercedes-amg' },
  { name: 'Porsche', slug: 'porsche' },
];
---

<PageLayout metadata={metadata}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 md:py-24 grid gap-10 lg:grid-cols-2 items-center">
    <div>
      <p class="text-primary font-bold mb-4">CCF · ПРОИЗВОДСТВО В КИТАЕ · B2B</p>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight text-heading">
        Карбоновые детали для вашего бизнеса
      </h1>
      <p class="text-lg text-muted mt-6">
        Для дистрибьюторов, тюнинг-ателье, магазинов и собственных брендов Центральной Азии. Подберите детали BMW,
        Mercedes-AMG и Porsche или обсудите разработку OEM/ODM.
      </p>
      <div class="flex flex-wrap gap-3 mt-8">
        <Button variant="primary" href="/vehicles/" text="Подобрать по автомобилю" />
        <Button
          variant="secondary"
          href={whatsappUrl('Оптовое предложение')}
          text="Получить оптовую цену"
          target="_blank"
          icon="tabler:brand-whatsapp"
        />
      </div>
      <p class="font-semibold text-primary mt-5">Общение на русском · Предложение в USD · Авиа- и морская перевозка</p>
      <p class="text-sm text-muted mt-5">
        Для расчёта: модель, год, фото автомобиля, детали, количество и город доставки.
      </p>
    </div>
    <img
      src="/images/verified/ccf-automotive-carbon-fiber-production-workshop.webp"
      alt="Производственная мастерская CCF в Китае"
      width="1200"
      height="900"
      loading="eager"
      fetchpriority="high"
      class="rounded-3xl w-full object-cover shadow-sm"
    />
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-12" aria-label="Условия поставки">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {
        [
          ['От 1 шт.', 'Минимальный заказ'],
          ['25–30 дней', 'Серийное производство'],
          ['1 год', 'Гарантия'],
          ['С 2006 года', 'Опыт производства композитов'],
        ].map(([value, label]) => (
          <div class="rounded-2xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 p-6">
            <>
              <dt class="text-sm text-muted">{label}</dt>
              <dd class="font-bold text-xl mt-2">{value}</dd>
            </>
          </div>
        ))
      }
    </dl>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <h2 class="text-3xl font-bold mb-3">Начните с марки автомобиля</h2>
    <p class="text-muted mb-6">
      BMW — каталог деталей с фотографиями. Mercedes-AMG и Porsche — подбор по каталогам моделей.
    </p>
    <div class="grid md:grid-cols-3 gap-5">
      {
        brands.map((brand) => (
          <a
            href={`/vehicles/${brand.slug}/`}
            class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200 dark:border-slate-700 p-8 hover:border-primary transition"
          >
            <>
              <h3 class="text-2xl font-bold">{brand.name}</h3>
              <p class="text-primary mt-4">Выбрать модель →</p>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <FeaturedProducts />
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <h2 class="text-3xl font-bold">Найдите нужный тип детали</h2>
    <p class="text-muted mt-3">
      {allProducts.length} карточки товаров. Выберите категорию, затем уточните автомобиль и комплектацию.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
      {
        Object.entries(categoryNamesRu)
          .filter(([slug]) => allProducts.some((p) => p.categorySlug === slug))
          .map(([slug, name]) => (
            <a
              href={`/products/${slug}/`}
              class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl p-5 hover:border-primary"
            >
              {name} →
            </a>
          ))
      }
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 grid md:grid-cols-2 gap-10">
    <div>
      <p class="text-primary font-bold">ПРЯМОЙ КОНТАКТ С ПРОИЗВОДИТЕЛЕМ</p><h2 class="text-3xl font-bold mt-3">
        От каталога до собственной марки
      </h2><p class="text-muted mt-4">
        CCF — B2B-платформа Guangzhou Chui Chui Feng Automotive Products Co., Ltd. Головной офис в Гуанчжоу,
        производственная база в Цинъюане, провинция Гуандун, Китай. Опыт работы с FRP с 2006 года, автомобильным
        карбоном с 2010 года, фокус на сухом карбоне с 2016 года. На сухой карбон приходится 95% производственного
        фокуса CCF.
      </p><a href="/about/" class="inline-block text-primary underline mt-4">О компании и производстве →</a>
    </div>
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200 dark:border-slate-700 p-7">
      <h3 class="text-2xl font-bold">Что обсудить до заказа</h3><ul class="list-disc pl-5 space-y-3 mt-5 text-muted">
        <li>Применяемость по кузову, году и комплектации автомобиля.</li><li>
          Материал, исполнение, комплектность и фотографии выбранного артикула.
        </li><li>Упаковку, количество, страну и город доставки.</li><li>
          Логотип, упаковку под вашим брендом и разработку OEM/ODM.
        </li>
      </ul><a href="/grow/oem-odm/" class="inline-block text-primary underline mt-5">Обсудить OEM/ODM →</a>
      <p class="text-muted mt-5">
        Оцените бюджет до закупки: добавьте к цене деталей свои расходы на перевозку и импорт.
      </p>
      <a href="/import-cost-calculator/" class="inline-block text-primary underline mt-3"
        >Рассчитать стоимость и маржу →</a
      >
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 mb-12">
    <div class="rounded-3xl bg-primary text-white p-8 md:p-12">
      <h2 class="text-3xl font-bold">Получите предложение под ваш заказ</h2><p class="mt-4 max-w-3xl">
        Пришлите список деталей или фотографии, модель и год автомобиля, количество и город доставки. Согласуем
        применяемость, цену, комплект поставки и сроки.
      </p><div class="flex flex-wrap gap-4 mt-6">
        <Button
          variant="secondary"
          class="bg-white text-black border-white hover:bg-gray-100"
          href={whatsappUrl('Расчёт оптового заказа')}
          text="Запросить цену в WhatsApp"
          target="_blank"
        /><a href="mailto:info@ccfrp.com" class="underline self-center">info@ccfrp.com</a>
      </div>
    </div>
  </section>
</PageLayout>
