---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شراء قطع الكربون: الكمية والمطابقة والشحن والضمان | CCF',
  description:
    'إجابات عن شراء قطع الكربون من CCF: الحد الأدنى للطلب والعينة والمطابقة وOEM/ODM والشحن والضمان. راجع الشروط قبل إرسال استفسار التوريد.',
};
---

<PageLayout metadata={metadata}>
  <!-- HeroText -->
  <HeroText
    tagline="مركز مساعدة المشتري"
    title="أسئلة شراء قطع ألياف الكربون بالجملة"
    subtitle="إجابات سريعة عن قطع ألياف الكربون للسيارات وتوافقها مع المركبات والطلب وOEM/ODM والشحن ودعم ما بعد البيع من CCF. كل سؤال يرتبط بالصفحة ذات الصلة لمراجعة معلومات أوفى."
    callToAction={{
      text: 'تواصل عبر واتساب',
      href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
      target: '_blank',
      icon: 'tabler:brand-whatsapp',
    }}
    callToAction2={{
      text: 'اطلب عرض سعر',
      href: 'https://ccfrp.com/contact/',
      target: '_blank',
      variant: 'secondary',
    }}
  />

  <!-- Topic index -->
  <Features2
    tagline="تصفح حسب الموضوع"
    title="بم تحتاج المساعدة؟"
    subtitle="ابدأ بالموضوع الأقرب لسؤالك — كل قسم أدناه يغطي جانباً من التوريد مع CCF."
    columns={3}
    items={[
      { title: 'عام', description: 'الشركة والمصنع وكيفية التواصل مع CCF.', icon: 'tabler:building-factory-2' },
      { title: 'الطلب والحد الأدنى', description: 'العينات والكميات والدفع.', icon: 'tabler:shopping-cart' },
      { title: 'المنتجات والتوافق', description: 'الكربون والمركبات وبيانات المنتج.', icon: 'tabler:car' },
      { title: 'OEM والتخصيص', description: 'القوالب والتطوير والسرية.', icon: 'tabler:settings' },
      { title: 'الشحن والمدة', description: 'الإنتاج والتسليم وشروط الاستيراد.', icon: 'tabler:truck-delivery' },
      { title: 'الضمان وما بعد البيع', description: 'العيوب والتلف ودعم ما بعد البيع.', icon: 'tabler:shield-check' },
    ]}
  />

  <!-- 01 General -->
  <FAQs
    tagline="01 · عام"
    title="عن CCF وخلفيتنا التصنيعية وكيفية التواصل"
    schema
    items={[
      {
        title: 'من هي CCF — مصنع أم شركة تجارية؟',
        description:
          'CCF هي موقع B2B لشركة Guangzhou Chui Chui Feng Automotive Products المحدودة — المقر الرئيسي في قوانغتشو وقاعدة الإنتاج في تشينغيوان، قوانغدونغ، الصين. <a class="text-link underline" href="/about">تعرّف على الشركة ←</a>',
      },
      {
        title: 'هل يمكنني زيارة المصنع أو مشاهدته عبر فيديو؟',
        description:
          'يمكن ترتيب زيارات المصنع ومناقشات المشاريع مسبقاً. تواصل معنا مع معلومات شركتك ومشروعك قبل التخطيط للزيارة.',
      },
      {
        title: 'كيف أتواصل مع CCF بخصوص منتج أو مشروع؟',
        description:
          'أرسل معلومات المركبة والمنتج والكمية والوجهة عبر واتساب أو البريد الإلكتروني لنراجع طلبك. <a class="text-link underline" href="/contact">صفحة الاتصال ←</a>',
      },
    ]}
  />

  <!-- 02 Ordering, Payment & MOQ -->
  <FAQs
    tagline="02 · الطلب والدفع والحد الأدنى"
    title="كيف تعمل طلبات الكتالوج والعينات والكميات والشروط التجارية"
    schema
    items={[
      {
        title: 'ما الحد الأدنى لكمية الطلب لقطع ألياف الكربون؟',
        description:
          'منتجات الكتالوج القياسية تدعم طلبات الوحدة الواحدة. أما الجملة والتخصيص وOEM/ODM فتعتمد متطلباتها على المنتج والمشروع.',
      },
      {
        title: 'ما طرق وشروط الدفع المتاحة؟',
        description: 'تُؤكَّد طريقة الدفع وشروطه لكل طلب على حدة في عرض السعر أو الفاتورة الأولية المطبقة.',
      },
      {
        title: 'هل يمكنني طلب عينة قبل طلب الجملة؟',
        description:
          'نعم. يمكن استخدام طلبات العينة والوحدة الواحدة من الكتالوج لتقييم جودة المنتج والتشطيب والتوافق قبل التخطيط لمشتريات أكبر.',
      },
      {
        title: 'هل يمكن مزج منتجات أو طرازات مركبات مختلفة في طلب واحد؟',
        description:
          'يمكن مراجعة متطلبات المنتجات المختلطة بناءً على أرقام المنتجات المختارة وتطبيقات المركبات والكميات وترتيبات الشحن.',
      },
      {
        title: 'هل أحتاج شركة مسجلة للتواصل أو الطلب من CCF؟',
        description:
          'تركز CCF على توريد B2B وسوق ما بعد البيع للسيارات. أخبرنا كيف تبيع أو تستخدم المنتجات لنوجهك إلى خيار التوريد المناسب.',
      },
    ]}
  />

  <!-- 03 Products & Fitment -->
  <FAQs
    tagline="03 · المنتجات والتوافق"
    title="الكربون وتوافق المركبات ومعلومات المنتج قبل الطلب"
    schema
    items={[
      {
        title: 'ما الفرق بين قطع الكربون الجاف والكربون الرطب للسيارات؟',
        description:
          'يتميز الكربون الجاف ببنية أخف وأقوى ومظهر أنظف لأنه يُصنع من نسيج مسبق التشريب يُعالج بالأوتوكلاف. <a class="text-link underline" href="/dry-carbon-vs-wet-carbon">اقرأ الدليل الكامل ←</a>',
      },
      {
        title: 'هل كل قطع CCF مصنوعة من الكربون الجاف؟',
        description:
          'الكربون الجاف هو تركيز إنتاجنا الرئيسي ويمثل حوالي 95% من نطاق منتجاتنا. ومع ذلك يجب تأكيد المادة والبنية لرمز المنتج المحدد قبل الطلب.',
      },
      {
        title: 'كيف أؤكد أن قطعة الكربون تناسب مركبتي بالضبط؟',
        description:
          'تحقق من الطراز وسنة الإنتاج ورمز الهيكل ونمط الهيكل ومستوى التجهيز وتكوين المصد أو الهيكل ذي الصلة قبل تأكيد المنتج. <a class="text-link underline" href="/vehicles">تصفح القطع حسب المركبة ←</a>',
      },
      {
        title: 'هل توفرون صور المنتجات والمواصفات وبيانات التوافق؟',
        description:
          'قد تشمل مراجع المنتج المتاحة الصور والمواصفات ومعلومات تطبيق المركبة. تعتمد المعلومات الدقيقة المتاحة على المنتج.',
      },
    ]}
  />

  <!-- 04 OEM & Custom -->
  <FAQs
    tagline="04 · OEM والتخصيص"
    title="التطوير والقوالب والعلامة التجارية والمشاريع السرية"
    schema
    items={[
      {
        title: 'كيف أبدأ مشروع OEM أو ODM لألياف الكربون؟',
        description:
          'ابدأ بالمركبة ومفهوم القطعة والمواد المرجعية والكمية المتوقعة ومتطلبات المشروع. ثم تُراجع نطاق التطوير والقوالب والعينات والتكاليف والجدول الزمني للمشروع. <a class="text-link underline" href="/grow/oem-odm">تعرّف على OEM/ODM ←</a>',
      },
      {
        title: 'من يملك القالب أو التجهيزات في مشروع مخصص؟',
        description: 'تُتفق ملكية القوالب واستخدامها المصرح به وأي حصريات كتابياً لكل مشروع مخصص أو OEM/ODM على حدة.',
      },
      {
        title: 'هل تحمي CCF التصاميم السرية ومعلومات مشاريع OEM؟',
        description:
          'يمكن حماية معلومات المشروع السرية بموجب اتفاقية عدم إفصاح (NDA) متفق عليها بين الطرفين. يجب تأكيد ترتيبات السرية والقوالب والتصميم الخاصة بالمشروع كتابياً.',
      },
      {
        title: 'هل يمكنني استخدام علامتي التجارية الخاصة على منتجات ألياف الكربون؟',
        description:
          'يمكن مراجعة متطلبات العلامة الخاصة والتغليف المخصص كجزء من مشروع جملة أو OEM/ODM، حسب المنتج ومتطلبات الطلب.',
      },
    ]}
  />

  <!-- 05 Shipping & Lead Time -->
  <FAQs
    tagline="05 · الشحن والمدة"
    title="توقيت الإنتاج والشحن الدولي ومسؤوليات الوجهة"
    schema
    items={[
      {
        title: 'كم تستغرق مدة إنتاج قطع ألياف الكربون؟',
        description:
          'يعتمد توقيت الإنتاج على ما إذا كان المنتج متوفراً أو يُصنع عند الطلب أو يتطلب تطويراً مخصصاً. تُؤكَّد المدة المطبقة لكل طلب أو مشروع على حدة.',
      },
      {
        title: 'هل تشحن CCF قطع ألياف الكربون دولياً؟',
        description:
          'يمكن مراجعة ترتيبات الشحن الدولي بناءً على الوجهة وحجم المنتج والكمية ومتطلبات الطلب. تُؤكَّد شروط الشحن لكل طلب.',
      },
      {
        title: 'من يتولى الرسوم الجمركية والضرائب والتخليص الجمركي؟',
        description:
          'تُؤكَّد الشروط التجارية ومسؤوليات بلد الوجهة لكل طلب. ما لم يُتفق خطياً على خلاف ذلك، تكون الرسوم الجمركية والضرائب ورسوم التخليص ورسوم بلد الوجهة الأخرى على عاتق المشتري.',
      },
      {
        title: 'كيف تُغلَّف قطع ألياف الكربون للشحن؟',
        description: 'يُختار التغليف وفقاً لحجم المنتج وشكله والكمية وطريقة الشحن، بهدف حماية القطع أثناء النقل.',
      },
    ]}
  />

  <!-- 06 Warranty & After-Sales -->
  <FAQs
    tagline="06 · الضمان وما بعد البيع"
    title="عيوب التصنيع والتلف أثناء النقل ومشاكل التوافق والمطالبات"
    schema
    items={[
      {
        title: 'ما الضمان المطبق على قطع CCF من ألياف الكربون؟',
        description:
          'قطع الكربون الجاف تحمل ضماناً لمدة سنة واحدة ضد عيوب التصنيع من تاريخ التسليم. أما تغطية ضمان الكربون الرطب فتعتمد على الشروط المؤكدة لكل طلب. <a class="text-link underline" href="/return-refund-policy">راجع سياسة الإرجاع والاسترداد ←</a>',
      },
      {
        title: 'ماذا أفعل إذا وصلت القطعة تالفة؟',
        description:
          'صوّر التغليف الخارجي وبطاقة الشحن والمنتج المتضرر، واحتفظ بالتغليف الأصلي، وأبلغ عن التلف الظاهر أثناء النقل خلال المدة المنصوص عليها في سياسة ما بعد البيع لدينا (7 أيام من التسليم).',
      },
      {
        title: 'ماذا لو استلمت قطعة بها عيب تصنيع؟',
        description:
          'تواصل مع CCF مع معلومات الطلب ووصف المشكلة وصور داعمة واضحة لتُراجع المطالبة وفقاً لسياسة الضمان المطبقة.',
      },
      {
        title: 'هل يمكن إرجاع منتج مخصص أو OEM/ODM؟',
        description:
          'لا يمكن عادةً إلغاء أو إرجاع أو استرداد المنتجات المخصصة وOEM/ODM بعد بدء الإنتاج أو القوالب أو أعمال التطوير المتفق عليها، باستثناء العيوب المشمولة أو الحلول الأخرى المتفق عليها كتابياً تحديداً.',
      },
    ]}
  />

  <!-- Closing CTA -->
  <CallToAction
    layout="banner"
    title="لم تجد إجابتك؟"
    subtitle="أرسل مركبتك ومرجع المنتج والكمية والوجهة — يراجع فريقنا طلبك خلال أوقات العمل (GMT+8)."
    actions={[
      {
        variant: 'primary',
        text: 'تواصل عبر واتساب',
        href: 'https://wa.me/8613427690360?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D9%82%D8%B7%D8%B9%20%D8%A3%D9%84%D9%8A%D8%A7%D9%81%20%D8%A7%D9%84%D9%83%D8%B1%D8%A8%D9%88%D9%86%20%D9%85%D9%86%20CCF%20%D9%88%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'secondary',
        text: 'اطلب عرض سعر',
        href: 'https://ccfrp.com/contact/',
        target: '_blank',
      },
    ]}
  />
</PageLayout>
