---
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { faqGroupsRu } from '~/data/faq-groups-ru';
import { whatsappUrl } from '~/utils/inquiry';
const metadata = {
  title: 'Закупка деталей CCF: MOQ, применяемость, доставка и гарантия',
  description:
    'Ответы CCF для B2B-покупателей: образцы и MOQ, подбор по автомобилю, OEM/ODM, сроки производства, импортные расходы, гарантия и транспортные повреждения.',
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'ru',
  mainEntity: faqGroupsRu.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    }))
  ),
};
---

<PageLayout metadata={metadata} includeBuyerResources={false}>
  <StructuredData slot="head" schema={schema} />
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-14 pb-7">
    <p class="text-primary font-bold">ПОМОЩЬ ОПТОВОМУ ПОКУПАТЕЛЮ</p><h1 class="text-4xl md:text-5xl font-bold mt-4">
      Вопросы о закупке деталей CCF
    </h1><p class="text-lg text-muted max-w-4xl mt-5">
      Выберите тему или сразу отправьте ваш запрос. Применяемость, исполнение и коммерческие условия подтверждаются для
      конкретного заказа.
    </p><nav aria-label="Темы вопросов" class="flex flex-wrap gap-3 mt-7">
      {
        faqGroupsRu.map((group) => (
          <a
            href={`#${group.id}`}
            class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-full px-4 py-2 hover:border-primary"
          >
            {group.title}
          </a>
        ))
      }
    </nav>
  </section>
  {
    faqGroupsRu.map((group) => (
      <section id={group.id} class="max-w-7xl mx-auto px-4 sm:px-6 py-7 scroll-mt-24">
        <>
          <h2 class="text-3xl font-bold mb-5">{group.title}</h2>
          <div class="grid md:grid-cols-2 gap-4">
            {group.items.map((item) => (
              <details class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
                <summary class="font-semibold cursor-pointer">{item.q}</summary>
                <p class="text-muted mt-3">{item.a}</p>
              </details>
            ))}
          </div>
        </>
      </section>
    ))
  }
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex flex-wrap gap-5 mb-7 text-primary underline">
      <a href="/return-refund-policy/">Полная гарантийная политика</a><a href="/terms/">Условия сайта и заказа</a><a
        href="/grow/oem-odm/">Проекты OEM/ODM</a
      ><a href="/contact/">Контакты</a>
    </div><Button
      href={whatsappUrl('Вопрос по закупке деталей CCF')}
      text="Задать вопрос в WhatsApp"
      target="_blank"
      variant="primary"
    />
  </section>
</PageLayout>
