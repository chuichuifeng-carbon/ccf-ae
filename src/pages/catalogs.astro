---
import PageLayout from '~/layouts/PageLayout.astro';
import ModelCatalogs from '~/components/widgets/ModelCatalogs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import catalogs from '~/data/b2b/catalogs.json';
import { getCanonical } from '~/utils/permalinks';

const url = String(getCanonical('/catalogs'));
const documents = catalogs.flatMap((group) =>
  group.entries.map((entry) => ({
    '@type': 'DigitalDocument',
    name: `${group.brand.toUpperCase()} ${entry.model}`,
    url: entry.url,
    encodingFormat: 'application/pdf',
  }))
);

const metadata = {
  title: 'PDF-каталоги деталей BMW, Mercedes-AMG и Porsche | CCF',
  description:
    'Оригинальные PDF-каталоги CCF по марке и модели: BMW, Mercedes-AMG и Porsche. Выберите позицию, исполнение и количество для запроса оптовой цены.',
};
---

<PageLayout metadata={metadata} includeBuyerResources={false}>
  <StructuredData
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      '@id': url + '#model-catalogs',
      mainEntityOfPage: { '@id': url + '#webpage' },
      name: 'Каталоги по моделям',
      numberOfItems: documents.length,
      itemListElement: documents.map((item, i) => ({ '@type': 'ListItem', position: i + 1, item })),
    }}
  />
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-14 pb-6">
    <p class="text-primary font-bold">BMW · MERCEDES-AMG · PORSCHE · PDF</p><h1
      class="text-4xl md:text-5xl font-bold mt-4"
    >
      Каталоги деталей по моделям автомобилей
    </h1><p class="text-lg text-muted max-w-4xl mt-5">
      Выберите марку и модель, откройте исходный PDF и отправьте название каталога, номер позиции, количество и город
      доставки. Номер строки относится к этому каталогу и не обязательно является заводским SKU.
    </p><div class="flex flex-wrap gap-4 mt-6">
      <a class="btn-primary" href="/vehicles/bmw/">Подобрать BMW по кузову</a><a class="btn-secondary" href="/contact/"
        >Запросить помощь с подбором</a
      >
    </div>
  </section>
  <ModelCatalogs />
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
    <h2 class="text-2xl font-bold mb-4">От позиции каталога к предложению</h2><p class="text-muted">
      Добавьте год и фотографии автомобиля, выбранное исполнение и нужный состав комплекта. Материал, применяемость,
      доступность и условия поставки согласуются по заказу. Исходные PDF могут содержать английский и китайский текст.
    </p><div class="flex flex-wrap gap-5 mt-5 text-primary underline">
      <a href="/products/">Карточки товаров</a><a href="/grow/wholesale/">Оптовые поставки</a><a href="/faqs/#fitment"
        >Вопросы по применяемости</a
      >
    </div>
  </section>
</PageLayout>
