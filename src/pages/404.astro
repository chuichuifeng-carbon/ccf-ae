---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `404 — Страница не найдена`;
---

<Layout metadata={{ title, robots: { index: false, follow: false } }}>
  <section class="flex items-center h-full px-4 py-12">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <p class="mb-8 font-bold text-9xl text-primary" aria-hidden="true">404</p>
        <h1 class="text-3xl font-semibold">Страница не найдена</h1>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          Эта страница не найдена. Перейдите на главную, в каталог или свяжитесь с CCF для подбора детали.
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn ml-4">На главную</a>
        <div class="flex flex-wrap justify-center gap-4 mt-6">
          <a class="text-primary underline" href="/products">Каталог деталей</a>
          <a class="text-primary underline" href="/catalogs">PDF-каталоги</a>
          <a class="text-primary underline" href="/contact">Помощь и запрос цены</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
