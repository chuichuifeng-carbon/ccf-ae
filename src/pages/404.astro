---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `404 — الصفحة غير موجودة`;
---

<Layout metadata={{ title, robots: { index: false, follow: false } }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <p class="mb-8 font-bold text-9xl text-primary" aria-hidden="true">404</p>
        <h1 class="text-3xl font-semibold">الصفحة غير موجودة</h1>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          عذراً، لم نتمكن من العثور على هذه الصفحة. يمكنك العودة إلى الصفحة الرئيسية لتصفح منتجاتنا وخدماتنا.
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn ml-4">العودة إلى الصفحة الرئيسية</a>
        <div class="flex flex-wrap justify-center gap-4 mt-6">
          <a class="text-primary underline" href="/products">تصفح قطع الكربون</a>
          <a class="text-primary underline" href="/catalogs">كتالوجات المركبات PDF</a>
          <a class="text-primary underline" href="/contact">المساعدة وطلب عرض سعر</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
